		//ДанныеТовара.Вставить("ДатаСинхронизации", ТекущаяДатаСеанса()); 
		
		МассивЗаписейРС.Добавить(Новый Структура("Номенклатура, Сайт, Кабинет, ИдентификаторМП, ИдентификаторПоставщика, НаименованиеМП, Бренд, Штрихкод, Активный, ДатаСинхронизации, Характеристика,
		|ИдентификаторХарактеристикиМП", Номенклатура, ВходныеДанные.Сайт, ВходныеДанные.Кабинет, XMLСтрока(ДанныеКарточки.nmID), XMLСтрока(ДанныеКарточки.vendorCode), ДанныеКарточки.title,
		ДанныеКарточки.brand, СтрСоединить(МассивШК, ";"), Истина, ТекДата, ПустаяХарактеристика, ИдентификаторХарактеристикиМП));			
			
	КонецЦикла;
	
	РегистрыСведений.ТоварыНаМаркетплейсах.ЗаписатьДанные(МассивЗаписейРС);
	
	ВыходныеДанные.Успешные.Добавить(СтрШаблон("Обработано %1 товаров", МассивЗаписейРС.Количество()));

КонецПроцедуры

Процедура СобратьОтгрузкиИзAPI(ПараметрыВыполнения = Неопределено) Экспорт

	Если XMLСтрока(ВходныеДанные.Кабинет) <> "381a99ab-2683-11f1-ab1a-005056a8011a" Тогда Возврат КонецЕсли;
	
	get_v3_supplies();
	
	МассивПоставок = Новый Массив;
	
	Для Каждого ДанныеОтгрузки Из ВыходныеДанные.Стек Цикл
		
		ОтгрузкаВБазе = Документы.Отгрузка.НайтиПоРеквизиту("IDПлощадки", ДанныеОтгрузки.id);
		
		Если Не ЗначениеЗаполнено(ОтгрузкаВБазе) Или (ДанныеОтгрузки.id = "WB-GI-268982900") или (ДанныеОтгрузки.id <> "WB-GI-268984163") Тогда МассивПоставок.Добавить(ДанныеОтгрузки) КонецЕсли;				
			
	КонецЦикла; 
	
	Если Не МассивПоставок.Количество() Тогда Возврат КонецЕсли;	
	
	Для Каждого ДанныеПоставки Из МассивПоставок Цикл
		
		Если ДанныеПоставки.id <> "WB-GI-268982900" И ДанныеПоставки.id <> "WB-GI-268984163" Тогда Продолжить КонецЕсли;
		
		ВыходныеДанные.Стек.Очистить();
		
		get_v3_supplies_orders(ДанныеПоставки.id);
		
		Если Не ВыходныеДанные.Стек.Количество() Тогда Продолжить КонецЕсли; 
		
		ОтгрузкаВБазе = Документы.Отгрузка.ОтгрузкаПоИдентификатору(ДанныеПоставки.id, ВходныеДанные.Кабинет);
		
		Если ЗначениеЗаполнено(ОтгрузкаВБазе) Тогда 
			ОтгрузкаОбъект = ОтгрузкаВБазе.ПолучитьОбъект();
		Иначе
			
			ОтгрузкаОбъект = Документы.Отгрузка.СоздатьДокумент();
		КонецЕсли;
		//ОтгрузкаОбъект.Заполнить(Новый Структура("Дата, ДатаОтгрузки, ID_СкладаМП, Кабинет, Габаритность, IsB2b, ВременнойСлот, Склад", XMLЗначение(ТИп("Дата"), ДанныеПоставки.createdAt), ТекущаяДатаСеанса(),
		//Неопределено, ВходныеДанные.Кабинет, Неопределено, ДанныеПоставки.isB2b, Неопределено, Неопределено)); 
		
		ЗаполнитьЗначенияСвойств(ОтгрузкаОбъект, Новый Структура("Дата, IDПлощадки, ДатаОтгрузки, ID_СкладаМП, Кабинет, Габаритность, IsB2b, ВременнойСлот, Склад, Сайт", XMLЗначение(ТИп("Дата"), ДанныеПоставки.createdAt),
		ДанныеПоставки.id, ТекущаяДатаСеанса(), Неопределено, ВходныеДанные.Кабинет, Неопределено, ДанныеПоставки.isB2b, Неопределено, Неопределено, ВходныеДанные.Сайт)); 
		
		КолВоОтправлений = 0;
		
		МассивОтправлений = Новый Массив;
		
		ОтгрузкаОбъект.Отправления.Очистить();
		
		Для Каждого НомерОТправления Из ВыходныеДанные.Стек Цикл
			Отправление = Документы.Отправление.ОтправлениеПоИдентификатору(ВходныеДанные.Кабинет, XMLСтрока(НомерОТправления));
			Если Не ЗначениеЗаполнено(Отправление) Тогда Продолжить КонецЕсли;
			НовстрокаОТгрузка = ОтгрузкаОбъект.Отправления.Добавить();
			НовстрокаОТгрузка.Номенклатура = Отправление.Товары[0].Номенклатура;
			НовстрокаОТгрузка.ЗаказМП = Отправление.ЗаказМП;
			НовстрокаОТгрузка.Отправление = Отправление;
			НовстрокаОТгрузка.Количество = Отправление.Товары[0].Количество;
			НовстрокаОТгрузка.IDТовараМаркетплейса = Отправление.Товары[0].IDТовараМаркетплейса;
			КолВоОтправлений = КолВоОтправлений + 1;
			МассивОтправлений.Добавить(Отправление);
		КонецЦикла;
		
		ОтгрузкаОбъект.Склад = Отправление.Склад;
		ОтгрузкаОбъект.Организация = Отправление.Организация;
		ОтгрузкаОбъект.Контрагент = Отправление.Контрагент;
		ОтгрузкаОбъект.Габаритность = Отправление.Габаритность;
		
		
		ОтгрузкаОбъект.ОбменДанными.Загрузка = Истина;
		ОтгрузкаОбъект.Записать();
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ОтгрузкаОтправления.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Отгрузка.Отправления КАК ОтгрузкаОтправления
		|ГДЕ
		|	ОтгрузкаОтправления.Отправление В(&МассивОтправлений)
		|	И ОтгрузкаОтправления.Ссылка.Проведен
		|	И ОтгрузкаОтправления.Ссылка.Ссылка <> &ТекОтгрузка";
		
		Запрос.УстановитьПараметр("МассивОтправлений", МассивОтправлений);
		Запрос.УстановитьПараметр("ТекОтгрузка", ОтгрузкаОбъект.Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			ОтгрузкаТаргет = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
			
			Индекс = ОтгрузкаТаргет.Отправления.Количество() - 1;
			
			Пока Индекс >= 0 Цикл
							
				СтрокаОтправление = ОтгрузкаТаргет.Отправления[Индекс];
				Если МассивОтправлений.Найти(СтрокаОтправление.Отправление) <> Неопределено Тогда
					ОтгрузкаТаргет.Отправления.удалить(Индекс);
				КонецЕсли;
				
				Индекс = Индекс -1; 
				
			КонецЦикла;	
			
			ОтгрузкаТаргет.ОбменДанными.Загрузка = Истина;
			ОтгрузкаТаргет.Записать();
			РегистрыСведений.ОтложенноеПроведениеДокументов.ДобавитьДокументВОчередьНаПроведение(ОтгрузкаТаргет.Ссылка);
			
		КонецЦикла;
	
	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА

		
	КонецЦикла;	
	
	ВыходныеДанные.Успешные.Добавить(СтрШаблон("Собрана %1 (%2 отправлений)", ОтгрузкаОбъект.Ссылка, КолВоОтправлений));

КонецПроцедуры

Процедура ПолучитьНовыеСборочныеЗаданияВБ(ПараметрыВыполнения = Неопределено) Экспорт
	
	get_marketplace_v3_orders();

	Для каждого СтрСтека Из ВыходныеДанные.Стек Цикл
		Если ОбщегоНазначения.СсылкаСуществует(Документы.ЗаказСМаркетплейса.НайтиПоРеквизиту("IDПлощадки", XMLСтрока(СтрСтека.id))) Тогда Продолжить КонецЕсли;
		
		Попытка
			СоздатьДокументЗаказМаркетплейса(СтрСтека);
		Исключение
			ЗафиксироватьОшибку(СтрШаблон("Ошибка создания заказа маркетплейса ':%1': %2", XMLСтрока(СтрСтека.id), ОписаниеОшибки()));
		КонецПопытки;
	КонецЦикла;		

	ВыходныеДанные.Успешные.Добавить(СтрШаблон("Обработано %1 товаров", ВыходныеДанные.Стек.Количество()));

КонецПроцедуры

Процедура СоздатьОтправленияВБ(ПараметрыВыполнения = Неопределено) Экспорт   
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДокументЗаказСМаркетплейса.Ссылка КАК ЗаказСМаркетплейса
		|ИЗ
		|	Документ.ЗаказСМаркетплейса КАК ДокументЗаказСМаркетплейса
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Отправление КАК Отправление
		|		ПО ДокументЗаказСМаркетплейса.Ссылка = Отправление.ЗаказМП
		|ГДЕ
		|	ДокументЗаказСМаркетплейса.Проведен
		|	И ДокументЗаказСМаркетплейса.Кабинет = &Кабинет
		|	И НЕ ДокументЗаказСМаркетплейса.IDПлощадки = """"
		|	И Отправление.Ссылка ЕСТЬ NULL
		|	И НЕ ДокументЗаказСМаркетплейса.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Кабинет", ВходныеДанные.Кабинет);
	
	РезультатЗапроса = Запрос.Выполнить();  
	
	Если РезультатЗапроса.Пустой() Тогда Возврат КонецЕсли;

	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если РегистрыСведений.СостояниеБизнесПроцессов.ПоОбъектуЕстьСтопФактор(Выборка.ЗаказСМаркетплейса) Тогда
			Продолжить;
		КонецЕсли;

    	СоздатьДокументОтправление(Выборка.ЗаказСМаркетплейса);	
	КонецЦикла;

КонецПроцедуры

Процедура ОтправитьОстатки(ПараметрыВыполнения = Неопределено) Экспорт
	
	Если Не ВходныеДанные.ДанныеКабинета.Остатки И Не ВходныеДанные.ОтправитьНулевыеОстатки Тогда ЗафиксироватьОшибку("Остатки НЕ выгружены. По кабинету не стоит признак выгрузки остатков."); Возврат; КонецЕсли;
	
	ДанныеОТоварах = Новый Массив;
	
	Если Не ВыходныеДанные.ИзФормы Тогда 	   		
		ТаблицаОстатков = ПолучитьТекущиеОстаткиНаМаркетплейсе(ПолучитьАктивныеТоварыПоКабиненту());
	Иначе 
		ТаблицаОстатков = ПараметрыВыполнения.ТаблицаОстатков;
	КонецЕсли;  
	
	Если Не ТаблицаОстатков.Количество() Тогда  
	    ЗафиксироватьОшибку("Нет данных по остаткам");
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗагруженнаяТаблица.ИдентификаторХарактеристикиМП КАК ИдентификаторХарактеристикиМП,
		|	ЗагруженнаяТаблица.ИдентификаторСклада КАК ИдентификаторСклада,
		|	ЗагруженнаяТаблица.СвободныйОстаток КАК СвободныйОстаток
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&ТЗ КАК ЗагруженнаяТаблица
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.ИдентификаторХарактеристикиМП КАК ИдентификаторХарактеристикиМП,
		|	ВТ.ИдентификаторСклада КАК ИдентификаторСклада,
		|	ВТ.СвободныйОстаток КАК СвободныйОстаток
		|ИЗ
		|	ВТ КАК ВТ
		|ИТОГИ ПО
		|	ИдентификаторСклада";

	Запрос.УстановитьПараметр("ТЗ", ТаблицаОстатков);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаИдентификаторСклада = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаИдентификаторСклада.Следующий() Цикл
        ДанныеОТоварах = Новый Массив;
		
		Выборка = ВыборкаИдентификаторСклада.Выбрать();
	
		Пока Выборка.Следующий() Цикл
			ДанныеОТоварах.Добавить(ПолучитьСтруктуруДляОтправкиОстатков(Выборка));
		КонецЦикла;   
		
		Для каждого Пакет Из ОбщийСервер.РазложитьМассивЭлементовНаПакеты(ДанныеОТоварах, 1000) Цикл 
			put_marketplace_v3_stock_warehouseId(ВыборкаИдентификаторСклада.ИдентификаторСклада, Пакет);
		КонецЦикла;
	КонецЦикла;

	ВыходныеДанные.Успешные.Добавить("По кабинету успешно переданы остатки");  
	
КонецПроцедуры

Процедура ОтправитьНулевыеОстатки(ПараметрыВыполнения = Неопределено) Экспорт       
	
	ВходныеДанные.ОтправитьНулевыеОстатки = Истина;
	ОтправитьОстатки(ПараметрыВыполнения);
	
КонецПроцедуры 

Процедура ПолучениеЭтикеток(ПараметрыВыполнения = Неопределено) Экспорт
	
	ПолучениеЭтикетокОтгрузки(ПараметрыВыполнения);
	ПолучениеЭтикетокОтправлений(ПараметрыВыполнения);	
		
КонецПроцедуры 

Процедура ПолучениеЭтикетокОтправлений(ПараметрыВыполнения = Неопределено)
	
	Если ТипЗнч(ПараметрыВыполнения) = Тип("Структура") И ПараметрыВыполнения.Свойство("Документ") И ТипЗнч(ПараметрыВыполнения.Документ) <> Тип("ДокументСсылка.Отправление") Тогда Возврат КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Отправление.IDПлощадки КАК IDПлощадки,
	|	Отправление.Ссылка КАК Отправление
	|ИЗ
	|	Документ.Отправление КАК Отправление
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОтправлениеПрисоединенныеФайлы КАК ОтправлениеПрисоединенныеФайлы
	|		ПО Отправление.Ссылка = ОтправлениеПрисоединенныеФайлы.ВладелецФайла
	|			И (ОтправлениеПрисоединенныеФайлы.ЭтоЭтикеткаМП)
	|ГДЕ
	|	Отправление.Проведен И ОтправлениеПрисоединенныеФайлы.Ссылка ЕСТЬ NULL
	|	И НЕ Отправление.IDПлощадки = """"
	|	И Отправление.Кабинет = &Кабинет
	|	И ВЫБОР
	|			КОГДА &ЕстьОтборПоОтправлению
	|				ТОГДА Отправление.Ссылка = &Отправление
	|						
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И Отправление.Статус = ""confirm""");
	
	Запрос.УстановитьПараметр("Кабинет", ВходныеДанные.Кабинет);
	Запрос.УстановитьПараметр("ЕстьОтборПоОтправлению", ВходныеДанные.Свойство("Отправление"));
	Запрос.УстановитьПараметр("Отправление", ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ВходныеДанные, "Отправление", Неопределено));
	
	РезультатЗапроса = Запрос.Выполнить();    
	
	Если РезультатЗапроса.Пустой() Тогда
		Если ВходныеДанные.Свойство("Отправление") Тогда
			ЗафиксироватьОшибку(СтрШаблон("%1 находится в не подходящем статусе. Ожидается 'confirm'", ВходныеДанные.Отправление));
		КонецЕсли;	
		Возврат;
	КонецЕсли;
	
	МассивСтикеров = Новый Массив;   
	Расширение = "svg";
	
	Выборка = РезультатЗапроса.Выбрать(); 
	ЕстьРеквизитЭтикеткаSVG = ОбщегоНазначения.ЕстьРеквизитОбъекта("ЭтикеткаSVG", Метаданные.Документы.Отправление);	
	
	Пока Выборка.Следующий() Цикл
		
		ДанныеСтикера = post_v3_orders_stickers(СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Выборка.IDПлощадки));	   
		
		Если ДанныеСтикера = Неопределено Тогда Продолжить КонецЕсли;
		
		//Добавим данные по стикеру в отправление
		Попытка
			
			мОтправление = Выборка.Отправление.ПолучитьОбъект();
			мОтправление.wb_sticker_partA = ДанныеСтикера.partA;
			мОтправление.wb_sticker_partB = ДанныеСтикера.partB;
			мОтправление.wb_sticker_данные = ДанныеСтикера.barcode; 
			
			Если ЕстьРеквизитЭтикеткаSVG Тогда мОтправление.ЭтикеткаSVG = ДанныеСтикера.file КонецЕсли;
			
			мОтправление.Записать(РежимЗаписиДокумента.Запись);
			
		Исключение
			
			ЗафиксироватьОшибку(СтрШаблон("Ошибка добавленния данных по стикеру в отправленние %1: %2", Выборка.Отправление, ОписаниеОшибки()));
			
		КонецПопытки; 
				
		Попытка
			АдресВХранилище = ПоместитьВоВременноеХранилище(ПолучитьДвоичныеДанныеИзBase64Строки(ДанныеСтикера.file));
			ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла(Новый Структура("ЭтоЭтикеткаМП", Истина));
			ПараметрыФайла.Автор = Пользователи.ТекущийПользователь();
			ПараметрыФайла.ВладелецФайлов = Выборка.Отправление;
			ПараметрыФайла.ИмяБезРасширения = СтрШаблон("Стикер от %1", Формат(ТекущаяДатаСеанса(), "ДЛФ=DDT"));
			ПараметрыФайла.РасширениеБезТочки = Расширение;    
			
			Этикетка = РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресВХранилище);
		Исключение
			
			ЗафиксироватьОшибку(СтрШаблон("Ошибка прикрепления стикера к файлам документа %1: %2", Выборка.Отправление, ОписаниеОшибки()));
			Продолжить; 
			
		КонецПопытки;		
		
	КонецЦикла;
	
КонецПроцедуры	

Процедура ОтменитьОтправления(ПараметрыВыполнения = Неопределено) Экспорт
	
	Если ТипЗнч(ПараметрыВыполнения) = Тип("Структура") И ПараметрыВыполнения.Свойство("Документ") И ТипЗнч(ПараметрыВыполнения.Документ) <> Тип("ДокументСсылка.Отправление") Тогда Возврат КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 100
	|	СостояниеБизнесПроцессов.БизнесПроцесс КАК БизнесПроцесс,
	|	СостояниеБизнесПроцессов.Объект КАК Отправление,
	|	СостояниеБизнесПроцессов.Объект.IDПлощадки КАК IDПлощадки,
	|	СостояниеБизнесПроцессов.Состояние КАК Состояние,
	|	СостояниеБизнесПроцессов.Решено КАК Решено,
	|	СостояниеБизнесПроцессов.Описание КАК Описание,
	|	СостояниеБизнесПроцессов.ДатаСобытия КАК ДатаСобытия,
	|	СостояниеБизнесПроцессов.ДатаЗавершения КАК ДатаЗавершения,
	|	СостояниеБизнесПроцессов.ОбъектРегистрации КАК ОбъектРегистрации
	|ИЗ
	|	РегистрСведений.СостояниеБизнесПроцессов КАК СостояниеБизнесПроцессов
	|ГДЕ
	|	СостояниеБизнесПроцессов.Состояние = ЗНАЧЕНИЕ(Справочник.СостоянияБизнесПроцессов.ОтправлениеОтмененоНаМаркете)
	|	И СостояниеБизнесПроцессов.ДатаЗавершения = ДАТАВРЕМЯ(1, 1, 1)
	|	И НЕ СостояниеБизнесПроцессов.Решено
	|	И СостояниеБизнесПроцессов.Объект.Кабинет = &Кабинет
	|	И СостояниеБизнесПроцессов.Объект ССЫЛКА Документ.Отправление
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаСобытия УБЫВ");
	
	Запрос.УстановитьПараметр("Кабинет", ВходныеДанные.Кабинет);
	Запрос.УстановитьПараметр("ЕстьОтборПоОтправлению", ВходныеДанные.Свойство("Отправление"));
	Запрос.УстановитьПараметр("Отправление", ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ВходныеДанные, "Отправление", Неопределено));
	
	РезультатЗапроса = Запрос.Выполнить();    
	
	Если РезультатЗапроса.Пустой() Тогда          
		Если ВходныеДанные.Свойство("Отправление") Тогда
			ЗафиксироватьОшибку(СтрШаблон("%1 Уже отменено на маркете", ВходныеДанные.Отправление));
		КонецЕсли;	
		//Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		patch_v3_orders_cancel(Выборка.Отправление, Выборка.IDПлощадки);	   
		
	КонецЦикла;
	
	ОбновитьСтатусыОтправленийОтмена(ПараметрыВыполнения);
	
	РегистрыСведений.СостояниеБизнесПроцессов.ОбработатьСостоянияОтправленийОтменено();
	
КонецПроцедуры	

Процедура ПолучениеЭтикетокОтгрузки(ПараметрыВыполнения = Неопределено) Экспорт
	
	Если ТипЗнч(ПараметрыВыполнения) = Тип("Структура") И ПараметрыВыполнения.Свойство("Документ") И ТипЗнч(ПараметрыВыполнения.Документ) <> Тип("ДокументСсылка.Отгрузка") Тогда Возврат КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Отгрузка.IDПлощадки КАК IDПлощадки,
	|	Отгрузка.Ссылка КАК Отгрузка
	|ИЗ
	|	Документ.Отгрузка КАК Отгрузка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОтгрузкаПрисоединенныеФайлы КАК ОтгрузкаПрисоединенныеФайлы
	|		ПО Отгрузка.Ссылка = ОтгрузкаПрисоединенныеФайлы.ВладелецФайла
	|			И (ОтгрузкаПрисоединенныеФайлы.ЭтоЭтикеткаМП)
	|ГДЕ
	|	Отгрузка.Проведен
	|	И НЕ Отгрузка.IDПлощадки = """"
	|	И Отгрузка.Кабинет = &Кабинет И ОтгрузкаПрисоединенныеФайлы.Ссылка ЕСТЬ NULL
	|	И ВЫБОР
	|			КОГДА &ЕстьОтборПоДокументам
	|				ТОГДА Отгрузка.Ссылка = &Отгрузка
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И Отгрузка.Закрыто");
	
	Запрос.УстановитьПараметр("Кабинет", ВходныеДанные.Кабинет);
	Запрос.УстановитьПараметр("ЕстьОтборПоДокументам", ВходныеДанные.Свойство("Отгрузка"));
	Запрос.УстановитьПараметр("Отгрузка", ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ВходныеДанные, "Отгрузка", Неопределено));
	
	РезультатЗапроса = Запрос.Выполнить();    
	
	Если РезультатЗапроса.Пустой() Тогда Возврат КонецЕсли;
	
	МассивСтикеров = Новый Массив;   
	Расширение = "svg";
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		                                                                         
		ДанныеСтикера = post_v3_supplies_barcode(Выборка.IDПлощадки);	   
		
		Если ДанныеСтикера = Неопределено Тогда Продолжить КонецЕсли;
		
		Попытка
			АдресВХранилище = ПоместитьВоВременноеХранилище(ПолучитьДвоичныеДанныеИзBase64Строки(ДанныеСтикера.file));
			ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла(Новый Структура("ЭтоЭтикеткаМП", Истина));
			ПараметрыФайла.Автор = Пользователи.ТекущийПользователь();
			ПараметрыФайла.ВладелецФайлов = Выборка.Отгрузка;
			ПараметрыФайла.ИмяБезРасширения = СтрШаблон("Стикер от %1", Формат(ТекущаяДатаСеанса(), "ДЛФ=DDT"));
			ПараметрыФайла.РасширениеБезТочки = Расширение;    
			
			Этикетка = РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресВХранилище);
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон("%1 этикетка загружена", Выборка.IDПлощадки),,, "Успешные");
		Исключение
			ЗафиксироватьОшибку(СтрШаблон("Ошибка прикрепления стикера к файлам документа %1: %2", Выборка.Отправление, ОписаниеОшибки()));
			Продолжить;
		КонецПопытки;	
		
		Если Не ОбщегоНазначения.СсылкаСуществует(Этикетка) Тогда Продолжить КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьОтгрузки(ПараметрыВыполнения = Неопределено) Экспорт
	
	//ПроверитьСоздатьОтгрузки(ВходныеДанные.Кабинет, 14);
	
	Документы.Отгрузка.СформироватьОтгрузкиПоОтправлениям(ВходныеДанные.Кабинет);
	
