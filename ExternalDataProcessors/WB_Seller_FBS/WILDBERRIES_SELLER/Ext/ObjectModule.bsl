КонецПроцедуры 

Процедура ОбработатьУпаковкуОтправлений(ПараметрыВыполнения = Неопределено) Экспорт
	
	
	
КонецПроцедуры

Процедура ДобавитьОтправленияВПоставкиНаМаркете()
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ОтправленияВБазе.Объект КАК Объект,
	|	ОтправленияВБазе.Состояние КАК СостояниеВБазе,
	|	ОтправленияВБазе.Решено КАК Решено,
	|	МАКСИМУМ(ВложенныйЗапрос.Отгрузка) КАК Отгрузка,
	|	ОтправленияНаМаркете.Состояние КАК СостояниеНаМаркете,
	|	ОтправленияВБазе.Объект.IDПлощадки КАК НомерОтправления
	|ПОМЕСТИТЬ Выборка
	|ИЗ
	|	РегистрСведений.СостояниеБизнесПроцессов КАК ОтправленияВБазе
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеБизнесПроцессов КАК ОтправленияНаМаркете
	|		ПО ОтправленияВБазе.Объект = ОтправленияНаМаркете.Объект
	|			И (ОтправленияНаМаркете.БизнесПроцесс = ""Маркетплейсы"")
	|			И (ОтправленияНаМаркете.Состояние = ЗНАЧЕНИЕ(Справочник.СостоянияБизнесПроцессов.ОтправлениеДобавленоВОтгрузкуНаМаркете))
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ОтгрузкаОтправления.Ссылка КАК Отгрузка,
	|			ОтгрузкаОтправления.Отправление КАК Отправление
	|		ИЗ
	|			Документ.Отгрузка.Отправления КАК ОтгрузкаОтправления
	|		ГДЕ
	|			ОтгрузкаОтправления.Ссылка.Проведен
	|			И НЕ ОтгрузкаОтправления.Ссылка.ПометкаУдаления
	|			И НЕ ОтгрузкаОтправления.Ссылка.Закрыто) КАК ВложенныйЗапрос
	|		ПО ОтправленияВБазе.Объект = ВложенныйЗапрос.Отправление
	|ГДЕ
	|	ОтправленияВБазе.БизнесПроцесс = ""Маркетплейсы""
	|	И ОтправленияВБазе.Состояние = ЗНАЧЕНИЕ(Справочник.СостоянияБизнесПроцессов.ОтправлениеДобавленоВОтгрузкув1с)
	|	И ОтправленияВБазе.Решено
	|	И ОтправленияВБазе.Объект.Кабинет = &Кабинет
	|	И ОтправленияНаМаркете.Состояние ЕСТЬ NULL
	|
	|СГРУППИРОВАТЬ ПО
	|	ОтправленияВБазе.Объект,
	|	ОтправленияВБазе.Состояние,
	|	ОтправленияВБазе.Решено,
	|	ОтправленияНаМаркете.Состояние,
	|	ОтправленияВБазе.Объект.IDПлощадки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Выборка.Объект КАК Отправление,
	|	Выборка.СостояниеВБазе КАК СостояниеВБазе,
	|	Выборка.Решено КАК Решено,
	|	Выборка.Отгрузка КАК Отгрузка,
	|	Выборка.СостояниеНаМаркете КАК СостояниеНаМаркете,
	|	Выборка.НомерОтправления КАК НомерОтправления,
	|	Выборка.Отгрузка.IDПлощадки КАК НомерОтгрузки
	|ИЗ
	|	Выборка КАК Выборка
	|ИТОГИ ПО
	|	Отгрузка");
	
	Запрос.УстановитьПараметр("Кабинет", ВходныеДанные.Кабинет);
	
	ВыборкаОтгрузка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаОтгрузка.Следующий() Цикл
		
		ВыборкаОтправлений = ВыборкаОтгрузка.Выбрать();
		
		МассивОтправленийНомеров = Новый Массив;
			
		Пока ВыборкаОтправлений.Следующий() Цикл МассивОтправленийНомеров.Добавить(Число(ВыборкаОтправлений.НомерОтправления)) КонецЦикла;		
		
		Если Не МассивОтправленийНомеров.Количество() Тогда Продолжить КонецЕсли;
		
		Для Каждого Пакет Из РазложитьМассивЭлементовНаПакеты(МассивОтправленийНомеров, 10) Цикл
			
			ОтветAPI = path_marketplace_v3_supplies_orders(ВыборкаОтгрузка.НомерОтгрузки, Пакет);	
			
		КонецЦикла;
		
	КонецЦикла; 	
	
КонецПроцедуры	

Процедура СоздатьПоставкиНаМаркете()
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Отгрузка.Ссылка КАК Отгрузка,
	                      |	СостояниеБизнесПроцессов.Состояние КАК Состояние,
	                      |	Отгрузка.Дата КАК Дата,
	                      |	ВЫБОР
	                      |		КОГДА Отгрузка.Габаритность = ЗНАЧЕНИЕ(Перечисление.Габариты.Пустаяссылка)
	                      |			ТОГДА 0
	                      |		ИНАЧЕ Отгрузка.Габаритность
	                      |	КОНЕЦ КАК Габаритность,
	                      |	Отгрузка.Склад КАК Склад,
	                      |	Отгрузка.ID_СкладаМП КАК ID_СкладаМП,
	                      |	Отгрузка.ДатаОтгрузки КАК ДатаОтгрузки,
	                      |	Отгрузка.IsB2b КАК IsB2b
	                      |ИЗ
	                      |	Документ.Отгрузка КАК Отгрузка
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеБизнесПроцессов КАК СостояниеБизнесПроцессов
	                      |		ПО Отгрузка.Ссылка = СостояниеБизнесПроцессов.Объект
	                      |			И (СостояниеБизнесПроцессов.БизнесПроцесс = ""Маркетплейсы"")
	                      |			И (СостояниеБизнесПроцессов.Состояние = ЗНАЧЕНИЕ(Справочник.СостоянияБизнесПроцессов.ОтгрузкаСозданаНаМаркете))
	                      |ГДЕ
	                      |	СостояниеБизнесПроцессов.Состояние ЕСТЬ NULL
	                      |	И Отгрузка.IDПлощадки = """"
	                      |	И Отгрузка.Кабинет = &Кабинет
	                      |	И Отгрузка.Проведен
	                      |	И НЕ Отгрузка.ПометкаУдаления");
	
	Запрос.УстановитьПараметр("Кабинет", ВходныеДанные.Кабинет);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Отказ = Ложь;
		
		Попытка
			
			ИД_Склада = ВходныеДанные.СоответсвиеСкладов.Получить(Выборка.ID_СкладаМП);
			
			Если Не ЗначениеЗаполнено(ИД_Склада) Тогда 
				ОбщегоНазначения.СообщитьПользователю(СтрШаблон("%1 не заполнен ид склада %2", Выборка.Отгрузка, Выборка.Склад),,, "Ошибки", Отказ);
			КонецЕсли;
			
			Если Отказ Тогда Продолжить КонецЕсли;
			
			НаименованиеОтгрузки = Стршаблон("Отгрузка %1 на склад %2 %3", Формат(Выборка.ДатаОтгрузки, "ДФ='d MMMM yyyy'"), ИД_Склада, ?(Выборка.IsB2b, " b2b", ""));
			
			ИД_Поставки = post_marketplace_v3_supplies(НаименованиеОтгрузки);
			
			Если Не ЗначениеЗаполнено(ИД_Поставки) Тогда Продолжить КонецЕсли;
			
			ОтгрузкаОбъект = Выборка.Отгрузка.ПолучитьОбъект();
			
			ОтгрузкаОбъект.ОбменДанными.Загрузка = Истина;
			ОтгрузкаОбъект.IDПлощадки = ИД_Поставки;
			ОтгрузкаОбъект.НаименованиеОтгрузки = НаименованиеОтгрузки;
			
			ОтгрузкаОбъект.Записать();
			
			РегистрыСведений.СостояниеБизнесПроцессов.ДобавитьЗапись("Маркетплейсы", Выборка.Отгрузка, Справочники.СостоянияБизнесПроцессов.ОтгрузкаСозданаНаМаркете,,, ИД_Поставки);
			
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон("%1 создана на маркете ИД: %2", Выборка.Отгрузка, ИД_Поставки),,, "Успешные");
			
		Исключение
			
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон("%1 не удалось создать на маркете: %2", Выборка.Отгрузка, ОписаниеОшибки()),,, "Ошибки");
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры 

Процедура ПеревестиОтгрузкиВДоставку(ПараметрыВыполнения = Неопределено) Экспорт
	
	Отгрузка = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ВходныеДанные, "Отгрузка", Неопределено);
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Отгрузка.Ссылка КАК Отгрузка,
	|	СостояниеБизнесПроцессов.Состояние КАК Состояние,
	|	Отгрузка.IDПлощадки КАК НомерПоставки
	|ИЗ
	|	Документ.Отгрузка КАК Отгрузка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеБизнесПроцессов КАК СостояниеБизнесПроцессов
	|		ПО Отгрузка.Ссылка = СостояниеБизнесПроцессов.Объект
	|			И (СостояниеБизнесПроцессов.Состояние = ЗНАЧЕНИЕ(Справочник.СостоянияБизнесПроцессов.ОтгрузкаПереданаВДоставку))
	|			И (СостояниеБизнесПроцессов.БизнесПроцесс = ""Маркетплейсы"")
	|ГДЕ
	|	Отгрузка.Закрыто
	|	И СостояниеБизнесПроцессов.Состояние ЕСТЬ NULL
	|	И Отгрузка.Проведен
	|	И Отгрузка.IDПлощадки <> """"
	|	И Отгрузка.Кабинет = &Кабинет
	|	И ВЫБОР
	|			КОГДА &ЕстьОтборПоОтгрузке
	|				ТОГДА Отгрузка.Ссылка = &Отгрузка
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ");
	
	Запрос.УстановитьПараметр("Кабинет", ВходныеДанные.Кабинет);
	Запрос.УстановитьПараметр("ЕстьОтборПоОтгрузке", ВходныеДанные.Свойство("Отгрузка"));
	Запрос.УстановитьПараметр("Отгрузка", Отгрузка);
	
	РезЗапроса = Запрос.Выполнить();
	
	Если РезЗапроса.Пустой() И ЗначениеЗаполнено(Отгрузка) Тогда
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("%1 уже переведена в доставку на маркете", Отгрузка),,, "Успешные"); 
	КонецЕсли;	

	Выборка = РезЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		patch_v3_supplies(Выборка.Отгрузка, Выборка.НомерПоставки);
	КонецЦикла;
	
КонецПроцедуры	

Процедура ПроверитьСоздатьОтгрузки(Кабинет, КолВоДней) Экспорт
	
	get_v3_supplies();
	
	МассивПоставокДляПроверки = Новый Массив;
	ТекДень = НачалоДня(ТекущаяДатаСеанса());
	
	Пока ТекДень <= КолВоДней Цикл
		
		МассивПоставокДляПроверки.Добавить(Формат(ТекДень, "ДЛФ=DD"));
		ТекДень = ТекДень + 60*60*24;
		
	КонецЦикла;
	
	Для Каждого ДеньПоставки Из МассивПоставокДляПроверки Цикл
		
		Попытка
			
			post_marketplace_v3_supplies(ДеньПоставки);
			
		Исключение 
			
			ЗафиксироватьОшибку(СтрШаблон("Ошибка создания поставки: %1", ДеньПоставки), Неопределено);
			
		КонецПопытки;
		
	КонецЦикла;	 
	
КонецПроцедуры	

Процедура ОбновитьСтатусыОтправлений(ПараметрыВыполнения = Неопределено) Экспорт
	
	ОбновитьСтатусыОтправленийОтмена(ПараметрыВыполнения);
	
	ВыходныеДанные.Стек.Очистить(); 
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Отправление.IDПлощадки КАК IDПлощадки,
	|	Отправление.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Отправление КАК Отправление
	|ГДЕ
	|	Отправление.Кабинет = &Кабинет
	|	И НЕ Отправление.ПометкаУдаления
	|	И Отправление.Дата >= &ДатаАктуальности
	|	И НЕ Отправление.Статус1С.Финальный
	|	И НЕ Отправление.Архив
	|	И НЕ Отправление.Упакован");
	
	Запрос.УстановитьПараметр("Кабинет", ВходныеДанные.Кабинет);
	Запрос.УстановитьПараметр("ДатаАктуальности", ТекущаяДатаСеанса()-60*60*24*4);
	
	МассивОтправленийЗапрос = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("IDПлощадки");
	
	МассивОтправлений = Новый Массив;
	Для Каждого НомерОтправления Из МассивОтправленийЗапрос Цикл МассивОтправлений.Добавить(Число(НомерОтправления)) КонецЦикла;
	
	Если Не МассивОтправлений.Количество() Тогда Возврат КонецЕсли;
	
	v3_orders_status(МассивОтправлений);
	
	Если Не ВыходныеДанные.Стек.Количество() Тогда Возврат КонецЕсли;
	
	ТЗ_СтатусыОтправленийМП = Новый ТаблицаЗначений;
	ТЗ_СтатусыОтправленийМП.Колонки.Добавить("id", ОбщегоНазначения.ОписаниеТипаСтрока(50));
	ТЗ_СтатусыОтправленийМП.Колонки.Добавить("supplierStatus", ОбщегоНазначения.ОписаниеТипаСтрока(150));
	ТЗ_СтатусыОтправленийМП.Колонки.Добавить("wbStatus", ОбщегоНазначения.ОписаниеТипаСтрока(150));
	
	Для Каждого ДанныеСтатусОтправления Из ВыходныеДанные.Стек Цикл
		
		ЗаполнитьЗначенияСвойств(ТЗ_СтатусыОтправленийМП.Добавить(), Новый Структура("id, supplierStatus, wbStatus", XMLСтрока(ДанныеСтатусОтправления.id), ДанныеСтатусОтправления.supplierStatus, ДанныеСтатусОтправления.wbStatus)); 
		
	КонецЦикла;	
	
	ОбновитьСтатусыОтправленийПО_ТЗ(ТЗ_СтатусыОтправленийМП);
	
КонецПроцедуры 

Процедура ОбновитьСтатусыОтправленийОтмена(ПараметрыВыполнения = Неопределено) Экспорт
	
	ВыходныеДанные.Стек.Очистить(); 
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	СостояниеБизнесПроцессов.БизнесПроцесс КАК БизнесПроцесс,
	|	ВЫРАЗИТЬ(СостояниеБизнесПроцессов.Объект КАК Документ.Отправление).IDПлощадки КАК IDПлощадки,
	|	ВЫРАЗИТЬ(СостояниеБизнесПроцессов.Объект КАК Документ.Отправление).Ссылка КАК Ссылка,
	|	СостояниеБизнесПроцессов.Объект КАК Отправление,
	|	СостояниеБизнесПроцессов.Состояние КАК Состояние,
	|	СостояниеБизнесПроцессов.Решено КАК Решено,
	|	СостояниеБизнесПроцессов.Описание КАК Описание,
	|	СостояниеБизнесПроцессов.ДатаСобытия КАК ДатаСобытия,
	|	СостояниеБизнесПроцессов.ДатаЗавершения КАК ДатаЗавершения,
	|	СостояниеБизнесПроцессов.ОбъектРегистрации КАК ОбъектРегистрации,
	|	СостояниеБизнесПроцессов.Ответственный КАК Ответственный,
	|	СостояниеБизнесПроцессов.ДанныеБП КАК ДанныеБП,
	|	ВЫРАЗИТЬ(СостояниеБизнесПроцессов.Объект КАК Документ.Отправление).Статус1С КАК Статус1С
	|ИЗ
	|	РегистрСведений.СостояниеБизнесПроцессов КАК СостояниеБизнесПроцессов
	|ГДЕ
	|	СостояниеБизнесПроцессов.Объект ССЫЛКА Документ.Отправление
	|	И СостояниеБизнесПроцессов.Состояние = ЗНАЧЕНИЕ(Справочник.СостоянияБизнесПроцессов.ОтправлениеОтмененоНаМаркете)
	|	И НЕ СостояниеБизнесПроцессов.Решено И ВЫРАЗИТЬ(СостояниеБизнесПроцессов.Объект КАК Документ.Отправление).Кабинет = &Кабинет
	|	И НЕ ВЫРАЗИТЬ(СостояниеБизнесПроцессов.Объект КАК Документ.Отправление).Архив");	
	
	Запрос.УстановитьПараметр("Кабинет", ВходныеДанные.Кабинет);
	
	МассивОтправленийЗапрос = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("IDПлощадки");
	
	МассивОтправлений = Новый Массив;
	Для Каждого НомерОтправления Из МассивОтправленийЗапрос Цикл МассивОтправлений.Добавить(Число(НомерОтправления)) КонецЦикла;
	
	Если Не МассивОтправлений.Количество() Тогда Возврат КонецЕсли;
	
	v3_orders_status(МассивОтправлений);
	
	Если Не ВыходныеДанные.Стек.Количество() Тогда Возврат КонецЕсли;
	
	ТЗ_СтатусыОтправленийМП = Новый ТаблицаЗначений;
	ТЗ_СтатусыОтправленийМП.Колонки.Добавить("id", ОбщегоНазначения.ОписаниеТипаСтрока(50));
	ТЗ_СтатусыОтправленийМП.Колонки.Добавить("supplierStatus", ОбщегоНазначения.ОписаниеТипаСтрока(150));
	ТЗ_СтатусыОтправленийМП.Колонки.Добавить("wbStatus", ОбщегоНазначения.ОписаниеТипаСтрока(150));
	
	Для Каждого ДанныеСтатусОтправления Из ВыходныеДанные.Стек Цикл
		
		ЗаполнитьЗначенияСвойств(ТЗ_СтатусыОтправленийМП.Добавить(), Новый Структура("id, supplierStatus, wbStatus", XMLСтрока(ДанныеСтатусОтправления.id), ДанныеСтатусОтправления.supplierStatus, ДанныеСтатусОтправления.wbStatus)); 
		
	КонецЦикла;	
	
	ОбновитьСтатусыОтправленийПО_ТЗ(ТЗ_СтатусыОтправленийМП); 
	
КонецПроцедуры	

// Обновляет статусы документов "Отправление" и связанных с ними заказов маркетплейса по таблице статусов, полученной от API Wildberries. Для каждого отправления, у которого
// статус площадки, дополнительный статус или статус 1С отличаются от полученных, реквизиты перезаписываются в режиме загрузки, а документ ставится в очередь отложенного
// проведения. Тот же статус переносится на документ-основание "Заказ с маркетплейса". Если новый статус относится к отменённому типу, соответствующее состояние
// бизнес-процесса "Отправление отменено на маркете" отмечается решённым. Каждое отправление обрабатывается в отдельной транзакции: ошибка по одному документу не прерывает
// обработку остальных, а фиксируется в журнале регистрации.
//
// Параметры:
//  ТЗ_СтатусыОтправленийМП - ТаблицаЗначений - статусы отправлений, полученные от API. Колонки:
//   * id             - Строка - номер отправления на площадке, сопоставляется с реквизитом IDПлощадки.
//   * wbStatus       - Строка - статус Wildberries (дополнительный статус).
//   * supplierStatus - Строка - статус продавца (основной статус площадки).
//
// Побочные эффекты:
//  * Записывает документы "Отправление" и "ЗаказСМаркетплейса" в режиме загрузки (ОбменДанными.Загрузка = Истина), без перепроведения.
//  * Ставит изменённые документы в регистр сведений "ОтложенноеПроведениеДокументов".
//  * Отмечает решёнными записи регистра сведений "СостояниеБизнесПроцессов" для отменённых отправлений.
//  * Добавляет сообщения об изменении статусов в коллекцию ВыходныеДанные.Успешные.
//  * При ошибке делает записи в журнале регистрации с событием "WB_Ошибка_Обновления_Статусов".
//
Процедура ОбновитьСтатусыОтправленийПО_ТЗ(ТЗ_СтатусыОтправленийМП)
	
	Запрос = Новый Запрос(ТекстЗапросаОбновитьСтатусыОтправлений());
	
	Запрос.УстановитьПараметр("ОтправленияМП", ТЗ_СтатусыОтправленийМП);
	Запрос.УстановитьПараметр("Кабинет", ВходныеДанные.Кабинет);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		СтатусПлощадки = ВыборкаДетальныеЗаписи.УстанавливаемыйСтатусПлощадки;
		ДопСтатусПлощадки = ВыборкаДетальныеЗаписи.УстанавливаемыйДопСтатусПлощадки;
		Статус1с = ВыборкаДетальныеЗаписи.УстанавливаемыйСтатус1с;
		
		НачатьТранзакцию();
		
		Попытка
			
			ОтправлениеОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
			ОтправлениеОбъект.Заблокировать();
			
			ЗаполнитьЗначенияСвойств(ОтправлениеОбъект, Новый Структура("Статус, ДопСтатус, Статус1С", СтатусПлощадки, ДопСтатусПлощадки, Статус1с));
			
			ОтправлениеОбъект.ОбменДанными.Загрузка = Истина;
			ОтправлениеОбъект.Записать();
			
			РегистрыСведений.ОтложенноеПроведениеДокументов.ДобавитьДокументВОчередьНаПроведение(ВыборкаДетальныеЗаписи.Ссылка);
			
			ВыходныеДанные.Успешные.Добавить(СтрШаблон("%1 статус изменен на 1с:%2 %3(%4)", ВыборкаДетальныеЗаписи.Ссылка, Статус1с, СтатусПлощадки, ДопСтатусПлощадки));
			
			Если ЗначениеЗаполнено(Статус1с) И ЗначениеЗаполнено(ОтправлениеОбъект.ЗаказМП) Тогда
				
				ЗаказОбъект = ОтправлениеОбъект.ЗаказМП.ПолучитьОбъект();
				ЗаказОбъект.Заблокировать();
				
				ЗаполнитьЗначенияСвойств(ЗаказОбъект, Новый Структура("Статус, Статус1С", СтатусПлощадки, Статус1с));
				
				ЗаказОбъект.ОбменДанными.Загрузка = Истина;
				ЗаказОбъект.Записать();
				
				РегистрыСведений.ОтложенноеПроведениеДокументов.ДобавитьДокументВОчередьНаПроведение(ОтправлениеОбъект.ЗаказМП);
				
			КонецЕсли;
			
			Если ВыборкаДетальныеЗаписи.ТипСтатусаМП = Перечисления.ТипыСтатусовМП.Отмененный Тогда
				
				РегистрыСведений.СостояниеБизнесПроцессов.ОтметитьОтменуОтправленияРешенной(ВыборкаДетальныеЗаписи.Ссылка);
				
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстОшибки = ОписаниеОшибки();
			
			ЗаписьЖурналаРегистрации("WB_Ошибка_Обновления_Статусов", УровеньЖурналаРегистрации.Ошибка, Метаданные.Документы.Отправление, ВыборкаДетальныеЗаписи.Ссылка, ТекстОшибки);
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьСтатусОтправления(НомерОтправления, СтатусПлощадки, ДопСтатусПлощадки, Кабинет)  
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Отправление.Ссылка КАК Ссылка,
	                      |	Отправление.Статус КАК Статус
	                      |ИЗ
	                      |	Документ.Отправление КАК Отправление
	                      |ГДЕ
	                      |	Отправление.Кабинет = &Кабинет
	                      |	И Отправление.IDПлощадки = &IDПлощадки
	                      |	И (Отправление.Статус <> &Статус
	                      |			ИЛИ Отправление.ДопСтатус <> &ДопСтатус
	                      |			ИЛИ Отправление.Статус1С = ЗНАЧЕНИЕ(Справочник.СтатусыМаркетплейсов.ПустаяСсылка))");
	
	Запрос.УстановитьПараметр("IDПлощадки", НомерОтправления);
	Запрос.УстановитьПараметр("Кабинет", Кабинет);
	Запрос.УстановитьПараметр("Статус", СтатусПлощадки);
	Запрос.УстановитьПараметр("ДопСтатус", ДопСтатусПлощадки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Попытка
			
			Статус1с = Справочники.СтатусыМаркетплейсов.ПолучитьСтатус(Справочники.СайтыМаркетплейсов.Wildberies, ?(ДопСтатусПлощадки = "declined_by_client", ДопСтатусПлощадки, СтатусПлощадки));
			
			ОтправлениеОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
			ОтправлениеОбъект.Заблокировать();
			ОтправлениеОбъект.Статус = СтатусПлощадки;
			ОтправлениеОбъект.ДопСтатус = ДопСтатусПлощадки;
			ОтправлениеОбъект.Статус1С = Статус1с;
			ОтправлениеОбъект.ОбменДанными.Загрузка = Истина;
			ОтправлениеОбъект.Записать(); 
			ОтправлениеОбъект.ОбменДанными.Загрузка = Ложь;
			//ОтправлениеОбъект.Записать(РежимЗаписиДокумента.Проведение);
			//ОтправлениеОбъект.Разблокировать(); 
			РегистрыСведений.ОтложенноеПроведениеДокументов.ДобавитьДокументВОчередьНаПроведение(ВыборкаДетальныеЗаписи.Ссылка);
			
			ВыходныеДанные.Успешные.Добавить(СтрШаблон("Отправление %1 статус изменен на %2(%3)", НомерОтправления, СтатусПлощадки, ДопСтатусПлощадки));
			
			Если Не ЗначениеЗаполнено(Статус1с) Тогда Продолжить КонецЕсли;
			
			ЗаказОбъект = ОтправлениеОбъект.ЗаказМП.ПолучитьОбъект();
			ЗаказОбъект.ОбменДанными.Загрузка = Истина;
			ЗаказОбъект.Статус = СтатусПлощадки;
			ЗаказОбъект.Статус1С = Статус1с;
			ЗаказОбъект.Записать();
			
		Исключение
			
		КонецПопытки;	
		
	КонецЦикла;
	
КонецПроцедуры	
#КонецОбласти 

#Область МетодыAPI

// Список карточек товаров
//
// Параметры:
//  Курсор - Неопределено, Структура - Пагинатор
//
Процедура post_content_v2_get_cards_list(Курсор = Неопределено)
	
	СтруктураКурсора = ?(Курсор = Неопределено, Новый Структура("limit", 100), Новый Структура("limit, updatedAt, nmID", 100, Курсор.updatedAt, Курсор.nmID));  
	
	Структура_settings = Новый Структура; 
	Структура_settings.Вставить("cursor", СтруктураКурсора);
	Структура_settings.Вставить("filter", Новый Структура("withPhoto", -1));    
	
	Адрес = СтрШаблон("https://%1/content/v2/get/cards/list", ДоменКонтент());
	
	ОтветAPI = КоннекторHTTP.PostJson(Адрес, Новый Структура("settings", Структура_settings), СформироватьДопПараметрыЗапроса(ДоменКонтент(), 5));
	
	Если ОтветAPI = Неопределено Тогда 
		ЗафиксироватьОшибку(СтрШаблон("Ошибка получения данных: %1", Адрес));
		Возврат;
	КонецЕсли;    
	
	Если Не ОтветAPI.Свойство("cards") Или Не ТипЗнч(ОтветAPI.cards) = Тип("Массив") Тогда 
		ЗафиксироватьОшибку(СтрШаблон("Ошибка получения данных: %1", Адрес), ОтветAPI);
		Возврат;
	КонецЕсли;
		
 	Если Не ОтветAPI.cards.Количество() Тогда Возврат КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВыходныеДанные.Стек, ОтветAPI.cards); 
	
	Если ОтветAPI.cursor.total >= 100 Тогда post_content_v2_get_cards_list(ОтветAPI.cursor) КонецЕсли;
	
КонецПроцедуры

