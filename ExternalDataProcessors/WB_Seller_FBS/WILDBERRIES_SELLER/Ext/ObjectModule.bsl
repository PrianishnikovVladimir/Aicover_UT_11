	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Host", ?(ЗначениеЗаполнено(Хост), Хост, "suppliers-api.wildberries.ru"));
	Заголовки.Вставить("Authorization", ВходныеДанные.Токен); 	

	Возврат Заголовки;
	
