КонецПроцедуры

Процедура patch_v3_supplies(Отгрузка, НомерПоставки)
	
	Адрес = СтрШаблон("https://%1/api/v3/supplies/%2/deliver", ДоменМаркетплейс(), НомерПоставки);
	
	ОтветAPI = КоннекторHTTP.PatchJson(Адрес, Новый Структура, СформироватьДопПараметрыЗапроса(ДоменМаркетплейс()));
			
	Если ОтветAPI = Неопределено Тогда 
		ЗафиксироватьОшибку(СтрШаблон("Ошибка получения данных: %1", Адрес));
		Возврат;
	КонецЕсли;    
	
	КодОшибкиСервиса = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ОтветAPI, "code", "");
	
	Если ЗначениеЗаполнено(КодОшибкиСервиса) И КодОшибкиСервиса <> "SupplyClosed" Тогда 
		ЗафиксироватьОшибку(СтрШаблон("Ошибка перевода отгрузки в доставку: %1 ответ сервиса %2", Адрес, КодОшибкиСервиса));
		Возврат;
	КонецЕсли;
	
	РегистрыСведений.СостояниеБизнесПроцессов.ДобавитьЗапись("Маркетплейсы", Отгрузка, Справочники.СостоянияБизнесПроцессов.ОтгрузкаПереданаВДоставку,,, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Отгрузка, "IDПлощадки"));
	
	ОбщегоНазначения.СообщитьПользователю(СтрШаблон(?(КодОшибкиСервиса = "SupplyClosed", "%1 уже была переведена в доставку ранее", "%1 переведена в доставку"), Отгрузка),,, "Успешные");
	
КонецПроцедуры 

Процедура patch_v3_orders_cancel(Отправление, ИД_Отправление)
	
	Адрес = СтрШаблон("https://%1/api/v3/orders/%2/cancel", ДоменМаркетплейс(), ИД_Отправление);
	
	ОтветAPI = КоннекторHTTP.PatchJson(Адрес, Новый Структура, СформироватьДопПараметрыЗапроса(ДоменМаркетплейс()));
	
	Если ОтветAPI = Неопределено Тогда 
		ЗафиксироватьОшибку(СтрШаблон("Ошибка получения данных: %1", Адрес));
		Возврат;
	КонецЕсли;    
	
	КодОшибкиСервиса = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ОтветAPI, "code", "");
	
	Если ЗначениеЗаполнено(КодОшибкиСервиса) Тогда ЗафиксироватьОшибку(СтрШаблон("%1 Ошибка отмены: КодСостояния(%2) ответ сервиса %3", Отправление, ОтветAPI.КодСостояния, КодОшибкиСервиса)) КонецЕсли;
	
	Если ОтветAPI.КодСостояния = 204 Тогда
		
		РегистрыСведений.СостояниеБизнесПроцессов.ОтметитьЗаписьРешенной(, Отправление, Справочники.СостоянияБизнесПроцессов.ОтправлениеОтмененоНаМаркете, ТекущаяДатаСеанса(), ); 
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("%1 отменено на маркете", Отправление),,, "Успешные");
		
	Иначе
		
		РегистрыСведений.СостояниеБизнесПроцессов.ОтметитьЗаписьСОшибкой(, Отправление, Справочники.СостоянияБизнесПроцессов.ОтправлениеОтмененоНаМаркете, ТекущаяДатаСеанса(), КодОшибкиСервиса, 
		Новый Структура("Отмена", СтрШаблон("Ошибка отмены: КодСостояния(%1) ответ сервиса %2", ОтветAPI.КодСостояния, КодОшибкиСервиса))); 
		
	КонецЕсли;	
	
КонецПроцедуры

