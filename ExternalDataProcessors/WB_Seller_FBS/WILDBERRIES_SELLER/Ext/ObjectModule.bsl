Процедура put_marketplace_v3_stock_warehouseId(ИДСклада, МассивОстатков)
		
	Адрес = СтрШаблон("https://%1/api/v3/stocks/%2", ДоменМаркетплейс(), ИДСклада);
	
	ОтветAPI = КоннекторHTTP.PutJson(Адрес, Новый Структура("stocks", МассивОстатков), СформироватьДопПараметрыЗапроса(ДоменМаркетплейс()));
	
	Если ОтветAPI = Неопределено Тогда 
		ЗафиксироватьОшибку(СтрШаблон("Ошибка получения данных: %1", Адрес));
		Возврат;
	КонецЕсли;    
	
	Если ТипЗнч(ОтветAPI) = Тип("Структура") Тогда
		Если ОтветAPI.Свойство("code") Тогда 
			ЗафиксироватьОшибку(СтрШаблон("Ошибка получения данных: %1", Адрес), ОтветAPI);
