Функция НайтиТоварПоБуквеКабинета(АртВБ, Кабинет)
	
	м_арт = СтрРазделить(АртВБ, ВходныеДанные.АртикулДляПоиска);
	
	Если м_арт.Количество() = 2 Тогда
		АртВБ = м_арт[0];
	ИначеЕсли м_арт.Количество() = 3 Тогда
		АртВБ = м_арт[1];
	КонецЕсли; 
	
	Возврат Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", АртВБ);
	
КонецФункции

Функция НайтиТоварПоАртикулуДополнительный(Знач АртВБ, barcode = Неопределено)
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("Успех" , Истина);
	СтруктураВозврата.Вставить("Товар" , Неопределено);
	СтруктураВозврата.Вставить("Ошибка", "");
	
	Если Не СтрНайти(АртВБ, "#") = 0 Тогда
		МассивАртикулов = СтрРазделить(АртВБ, "#"); 
		
		Если Не СтрНайти(МассивАртикулов[1], ВходныеДанные.АртикулДляПоиска) = 0 Тогда
			НайденныйТовар = НайтиТоварПоБуквеКабинета(МассивАртикулов[1], ВходныеДанные.Кабинет);
			
			Если НайденныйТовар.Пустая() Тогда
				СтруктураВозврата.Успех  = Ложь;
				СтруктураВозврата.Ошибка = СтрШаблон("Не найден товар по арту с буквой путем разложения %1", МассивАртикулов[1]);   
				
				Возврат СтруктураВозврата;
			Иначе
				СтруктураВозврата.Товар = НайденныйТовар;
				
				Возврат СтруктураВозврата;
			КонецЕсли;
		КонецЕсли; 
		
		НайденныйТовар = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", МассивАртикулов[1]);  
		
		Если НайденныйТовар.Пустая() Тогда
			СтруктураВозврата.Успех = Ложь;
			СтруктураВозврата.Ошибка = СтрШаблон("Не найден товар по новому артикулу %1", АртВБ);
			Возврат СтруктураВозврата;
		КонецЕсли;
	ИначеЕсли Найти(АртВБ, ВходныеДанные.АртикулДляПоиска) <> 0 Тогда
		
		Если Лев(АртВБ, 3) = "gru" Тогда
			АртВБ = Лев(АртВБ, СтрДлина(АртВБ) - 1);
