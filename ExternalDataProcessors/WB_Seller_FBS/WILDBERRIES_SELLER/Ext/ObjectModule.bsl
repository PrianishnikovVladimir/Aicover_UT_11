Процедура post_marketplace_v3_stock_warehouseId(ИДСклада, МассивШК, Стек)

	Адрес = СтрШаблон("https://%1/api/v3/stocks/%2", ДоменМаркетплейс(), ИДСклада);
	
	ОтветAPI = КоннекторHTTP.PostJson(Адрес, Новый Структура("chrtIds", МассивШК), СформироватьДопПараметрыЗапроса(ДоменМаркетплейс(), 5));
	
	Если ОтветAPI = Неопределено Тогда 
		ЗафиксироватьОшибку(СтрШаблон("Ошибка получения данных: %1", Адрес));
		Возврат;
	КонецЕсли;    
	
	Если Не ОтветAPI.Свойство("stocks") Тогда 
		ЗафиксироватьОшибку(СтрШаблон("Ошибка получения данных: %1", Адрес), ОтветAPI);
		Возврат;
	КонецЕсли;     
	
	Для каждого СтрОтвета Из ОтветAPI.stocks Цикл
		Стек.Добавить(Новый Структура("ИДСклада, ИдентификаторХарактеристикиМП, Остаток", ИДСклада, XMLСтрока(СтрОтвета.chrtId), СтрОтвета.amount));	
	КонецЦикла;
	
