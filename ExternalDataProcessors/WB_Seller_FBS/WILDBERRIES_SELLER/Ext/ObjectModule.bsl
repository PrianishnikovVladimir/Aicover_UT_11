Процедура ЗафиксироватьОшибку(ТекстСообщения, ДанныеОтвета = Неопределено)

	ОбщегоНазначения.СообщитьПользователю(СтрШаблон("%1%2%3", ТекстСообщения, ?(ДанныеОтвета = Неопределено, "", ":" + Символы.ПС), 
	?(ДанныеОтвета = Неопределено, "", КоннекторHTTP.ОбъектВJson(ДанныеОтвета))),,, "Ошибки")

КонецПроцедуры

// Разложить массив элементов на пакеты
//
// Параметры:
//  МассивЭлементов	 - Массив
//  КолВоВПакете	 - Число
// 
// Возвращаемое значение:
// Массив 
//
Функция РазложитьМассивЭлементовНаПакеты(МассивЭлементов, КолВоВПакете = 100)
	
	Если Не МассивЭлементов.Количество() Тогда Возврат Новый Массив	КонецЕсли;
	
	МассивПакетов = Новый Массив;
	
	ВсегоЭлементов = МассивЭлементов.Количество();
	
	Если ВсегоЭлементов > КолВоВПакете Тогда 
		Пока МассивЭлементов.Количество() Цикл
			МассивДляОтправки = Новый массив;
			
			НПП = МассивЭлементов.Количество();
			
			Пока НПП > 0 и МассивДляОтправки.Количество() < КолВоВПакете Цикл
				МассивДляОтправки.Добавить(МассивЭлементов[НПП - 1]);
				МассивЭлементов.Удалить(НПП - 1);
				НПП = НПП - 1;
			КонецЦикла;
			
			МассивПакетов.Добавить(МассивДляОтправки);
		КонецЦикла;
	Иначе
		МассивПакетов.Добавить(МассивЭлементов);   
	КонецЕсли;   	
	
	Возврат МассивПакетов;
	
КонецФункции 
#КонецОбласти     






