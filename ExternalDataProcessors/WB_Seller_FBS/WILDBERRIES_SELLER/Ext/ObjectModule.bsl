// Возвращает текст пакетного запроса для отбора отправлений, у которых статусы отличаются от полученных от API Wildberries, и определения устанавливаемых значений статусов.
// Статус 1С подбирается по наименованию статуса в справочнике "СтатусыМаркетплейсов": для отменённых и отклонённых отправлений — по дополнительному статусу (wbStatus),
// в остальных случаях — по статусу продавца (supplierStatus).
//
// Возвращаемое значение:
//  Строка - текст запроса. Требует установки параметров "ОтправленияМП" (ТаблицаЗначений) и "Кабинет" (СправочникСсылка.КабинетыМаркетплейсов).
//
Функция ТекстЗапросаОбновитьСтатусыОтправлений()
	
	Возврат "ВЫБРАТЬ
	|	ОтправленияМП.id КАК id,
	|	ОтправленияМП.wbStatus КАК wbStatus,
	|	ОтправленияМП.supplierStatus КАК supplierStatus
	|ПОМЕСТИТЬ ОтправленияМП
	|ИЗ
	|	&ОтправленияМП КАК ОтправленияМП
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОтправленияМП.id КАК НомерОтправления,
	|	ОтправленияМП.supplierStatus КАК УстанавливаемыйСтатусПлощадки,
	|	Отправление.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА ОтправленияМП.wbStatus ПОДОБНО ""%cancel%""
	|				ИЛИ ОтправленияМП.wbStatus ПОДОБНО ""%decline%""
	|			ТОГДА ПоискСтатусДоп.Ссылка
	|		ИНАЧЕ ПоискСтатус.Ссылка
	|	КОНЕЦ КАК УстанавливаемыйСтатус1с,
	|	ОтправленияМП.wbStatus КАК УстанавливаемыйДопСтатусПлощадки,
	|	Отправление.Статус КАК Статус,
	|	Отправление.Статус1С КАК Статус1С,
	|	ПоискСтатус.Ссылка КАК СтатусОсн,
	|	ПоискСтатусДоп.Ссылка КАК СтатусДОП
	|ПОМЕСТИТЬ Финал
	|ИЗ
	|	ОтправленияМП КАК ОтправленияМП
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Отправление КАК Отправление
	|		ПО ОтправленияМП.id = Отправление.IDПлощадки
	|			И (Отправление.Кабинет = &Кабинет)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтатусыМаркетплейсов КАК ПоискСтатусДоп
	|		ПО ОтправленияМП.wbStatus = ПоискСтатусДоп.Наименование
	|			И (ПоискСтатусДоп.Сайт = ЗНАЧЕНИЕ(Справочник.СайтыМаркетплейсов.Wildberies))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтатусыМаркетплейсов КАК ПоискСтатус
	|		ПО ОтправленияМП.supplierStatus = ПоискСтатус.Наименование
	|			И (ПоискСтатус.Сайт = ЗНАЧЕНИЕ(Справочник.СайтыМаркетплейсов.Wildberies))
	|ГДЕ
	|	(Отправление.Статус <> ОтправленияМП.supplierStatus
	|			ИЛИ Отправление.ДопСтатус <> ОтправленияМП.wbStatus
	|			ИЛИ Отправление.Статус1С = ЗНАЧЕНИЕ(Справочник.СтатусыМаркетплейсов.ПустаяСсылка)
	|			ИЛИ ВЫБОР
	|				КОГДА ОтправленияМП.wbStatus ПОДОБНО ""%cancel%""
	|						ИЛИ ОтправленияМП.wbStatus ПОДОБНО ""%decline%""
	|					ТОГДА ПоискСтатусДоп.Ссылка
	|				ИНАЧЕ ПоискСтатус.Ссылка
	|			КОНЕЦ <> Отправление.Статус1С)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Финал.Ссылка КАК Ссылка,
	|	Финал.УстанавливаемыйСтатус1с КАК УстанавливаемыйСтатус1с,
	|	Финал.УстанавливаемыйДопСтатусПлощадки КАК УстанавливаемыйДопСтатусПлощадки,
	|	Финал.УстанавливаемыйСтатусПлощадки КАК УстанавливаемыйСтатусПлощадки,
	|	Финал.УстанавливаемыйСтатус1с.ТипСтатусаМП КАК ТипСтатусаМП
	|ИЗ
	|	Финал КАК Финал";
	
КонецФункции
// Процедура - Добавить отправление в поставку = К УДАЛЕНИЮ
//
// Параметры:
//  Отправление	 - 	 - 
//
Процедура ДобавитьОтправлениеВПоставку(Отправление)
	
	Возврат;
	
	ОтсечкаTimeSlotFBS = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВходныеДанные.Кабинет, "ОтсечкаTimeSlotFBS");
	Таймслот = ?(ЗначениеЗаполнено(ОтсечкаTimeSlotFBS), ОтсечкаTimeSlotFBS, '00010101' + 60 * 60 * 9);     
	
	ДатаДокумента  = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Отправление, "Дата"); 
	ДеньДокумента  = НачалоДня(ДатаДокумента); 
	ВремяДокумента =  '00010101' + (ДатаДокумента - ДеньДокумента);   
	
	ДеньПоставки = ДеньДокумента;
	
	Если ВремяДокумента >= Таймслот Тогда ДеньПоставки = ДеньПоставки + 60 * 60 * 24 КонецЕсли;   
	
	ОбъектОтгрузка = ПолучитьСоздатьПоставку(ДеньПоставки, Отправление);  
	
	Если ОбъектОтгрузка = Неопределено Тогда 
		ЗафиксироватьОшибку(СтрШаблон("Ошибка добавления отправления %1 в поставку", Отправление)); 
		Возврат;
	КонецЕсли; 
	
	СтруктураОтправления = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Отправление, "IDПлощадки, ЗаказМП");
	
	ОтветДобавленияОтправлениеВПоставку = path_marketplace_v3_supplies_orders(ОбъектОтгрузка.IDПлощадки, СтруктураОтправления.IDПлощадки);    
	
	Если Не ОтветДобавленияОтправлениеВПоставку Тогда 
		ДобавитьЗаписьБизнесПроцесса(СтрШаблон("Ошибка добавление в поставку %1", ОбъектОтгрузка.IDПлощадки), Отправление);
		
		ЗафиксироватьОшибку(СтрШаблон("Ошибка добавления отправления %1 в поставку", Отправление)); 
		Возврат;
	КонецЕсли;
	
	НоваяСтрокаТЧ_Отправления = ОбъектОтгрузка.Отправления.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрокаТЧ_Отправления, Отправление.Товары[0]);
	НоваяСтрокаТЧ_Отправления.ЗаказМП = СтруктураОтправления.ЗаказМП;
	НоваяСтрокаТЧ_Отправления.Отправление = Отправление;    
	
	Попытка
		ОбъектОтгрузка.Записать(РежимЗаписиДокумента.Проведение);	
		ВыходныеДанные.Успешные.Добавить(СтрШаблон("Документ %1 добавлен в %2", Отправление, ОбъектОтгрузка.Ссылка));
	Исключение   
		ДобавитьЗаписьБизнесПроцесса(СтрШаблон("Ошибка добавление в поставку %1", ОбъектОтгрузка.IDПлощадки), Отправление);
		ЗафиксироватьОшибку(СтрШаблон("Ошибка добавления отправления %1 в поставку %2", Отправление, ОписаниеОшибки())); 
	КонецПопытки;

КонецПроцедуры    

Функция ПолучитьСоздатьПоставку(ДатаОтгрузки, Отправление)   
	
	ДанныеОтправления = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Отправление, "Склад, Габаритность");	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Отгрузка.Ссылка КАК Ссылка,
		|	Отгрузка.IDПлощадки КАК IDПлощадки
		|ИЗ
		|	Документ.Отгрузка КАК Отгрузка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыДокументовМаркетплейсов КАК СтатусыДокументовМаркетплейсов
		|		ПО СтатусыДокументовМаркетплейсов.Документ = Отгрузка.Ссылка
		|ГДЕ
		|	Отгрузка.Кабинет = &Кабинет
		|	И НАЧАЛОПЕРИОДА(Отгрузка.ДатаОтгрузки, ДЕНЬ) = &ДатаОтгрузки
		|	И Отгрузка.Склад = &Склад
		|	И Отгрузка.Проведен
		|	И Отгрузка.Габаритность = &Габаритность
		|	И НЕ ЕСТЬNULL(СтатусыДокументовМаркетплейсов.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыДокументовМаркетплейсов.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументовМаркетплейсов.Закрыто)";
	
	Запрос.УстановитьПараметр("ДатаОтгрузки", НачалоДня(ДатаОтгрузки));
	Запрос.УстановитьПараметр("Кабинет", 	  ВходныеДанные.Кабинет);
	Запрос.УстановитьПараметр("Склад", 	  	  ДанныеОтправления.Склад);
	Запрос.УстановитьПараметр("Габаритность", ДанныеОтправления.Габаритность);
	
	РезультатЗапроса = Запрос.Выполнить();  
	
	Если РезультатЗапроса.Пустой() Тогда
		//Создаем поставку по API и создаем документ Отгрузка в БД
		ID_Поставки = post_marketplace_v3_supplies(СтрШаблон("%1", Формат(ДатаОтгрузки, "ДЛФ=DD")));	
		
		Если ID_Поставки = Неопределено Тогда 
			ДобавитьЗаписьБизнесПроцесса("Ошибка создания поставки", Отправление);
			Возврат Неопределено;	
		КонецЕсли;

		НовыйДокумент = Документы.Отгрузка.СоздатьДокумент(); 
		
		ЗаполнитьЗначенияСвойств(НовыйДокумент, Отправление, "Организация, Клиент, Контрагент, Сайт, Кабинет, Склад, Габаритность"); 
		
		НовыйДокумент.Дата 		   = ДатаОтгрузки;
		НовыйДокумент.ДатаОтгрузки = ДатаОтгрузки; 
		НовыйДокумент.IDПлощадки   = ID_Поставки;  
		
		Попытка
			НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);      
			
			РегистрыСведений.СтатусыДокументовМаркетплейсов.СоздатьЗапись(НовыйДокумент.Ссылка, ПредопределенноеЗначение("Перечисление.СтатусыДокументовМаркетплейсов.Новая"));
		Исключение
			ДобавитьЗаписьБизнесПроцесса("Ошибка создания поставки", Отправление);
			Возврат Неопределено;
		КонецПопытки;
		
		Возврат НовыйДокумент;
	Иначе               
		//Возвращаем документ Отгруз
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		ОбъектПоставка = Выборка.Ссылка.ПолучитьОбъект(); 
		
		Если ОбъектПоставка.Заблокирован() Тогда 
			ДобавитьЗаписьБизнесПроцесса("Ошибка создания поставки", Отправление);
			Возврат Неопределено;
		КонецЕсли;
		
		Попытка
			ОбъектПоставка.Заблокировать();
		Исключение
			ДобавитьЗаписьБизнесПроцесса("Ошибка создания поставки", Отправление);
			Возврат Неопределено;
		КонецПопытки;
		
		Возврат ОбъектПоставка;
	КонецЕсли;
	
КонецФункции 

Процедура ДобавитьЗаписьБизнесПроцесса(НаименованиеСостояния, Документ)

	СостояниеБизнесПроцесса = Справочники.СостоянияБизнесПроцессов.НайтиПоНаименованию(НаименованиеСостояния, Истина);
	
	Если ОбщегоНазначения.СсылкаСуществует(СостояниеБизнесПроцесса) Тогда 
		РегистрыСведений.СостояниеБизнесПроцессов.ДобавитьЗапись("Маркетплейсы", Документ, СостояниеБизнесПроцесса); 	
	КонецЕсли;

КонецПроцедуры

