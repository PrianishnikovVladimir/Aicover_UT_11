// Добавить отправления в поставку
//
// Параметры:
//  НомерПоставки    - Строка
//  НомерОтправления - Строка
// 
// Возвращаемое значение:
// Булево - Истина - Отправление добавлено в поставку
//
Функция path_marketplace_v3_supplies_orders(НомерПоставки, МассивНомеровОтправлений) 
	
	Если ПустаяСтрока(НомерПоставки) Или Не МассивНомеровОтправлений.Количество() Тогда Возврат Ложь КонецЕсли;
	
	Адрес = СтрШаблон("https://%1/api/marketplace/v3/supplies/%2/orders", ДоменМаркетплейс(), НомерПоставки);
	
	ОтветAPI = КоннекторHTTP.PatchJson(Адрес, Новый Структура("orders", МассивНомеровОтправлений), СформироватьДопПараметрыЗапроса(ДоменМаркетплейс(), 5));
	
	Если ОтветAPI = Неопределено Тогда 
		ЗафиксироватьОшибку(СтрШаблон("Ошибка получения данных: %1", Адрес));
		Возврат Ложь;  
	КонецЕсли;    
	
	Если ТипЗнч(ОтветAPI) <> Тип("Структура") Тогда      
		ЗафиксироватьОшибку(СтрШаблон("Ошибка получения данных: %1", Адрес), ОтветAPI);
		Возврат Ложь;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ОтветAPI, "КодСостояния", 0) <> 204 Тогда      
		ЗафиксироватьОшибку(СтрШаблон("Ошибка получения данных: %1", Адрес), ОтветAPI);
		Возврат Ложь;
	КонецЕсли;	
	
	Отгрузка = Документы.Отгрузка.НайтиПоРеквизиту("IDПлощадки", НомерПоставки);
	
	Для Каждого НомерОтправления Из МассивНомеровОтправлений Цикл
		Отправление = Документы.Отправление.НайтиПоРеквизиту("IDПлощадки", XMLСтрока(НомерОтправления));
		РегистрыСведений.СостояниеБизнесПроцессов.ДобавитьЗапись("Маркетплейсы", Отправление, Справочники.СостоянияБизнесПроцессов.ОтправлениеДобавленоВОтгрузкуНаМаркете,,, Отгрузка);
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("%1 добавлено в %2 на маркете", Отправление, Отгрузка),,, "Успешные");
	КонецЦикла;	
	
	Возврат ОтветAPI;
	
КонецФункции  

