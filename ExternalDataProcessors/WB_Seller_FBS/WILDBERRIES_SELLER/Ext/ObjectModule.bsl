Процедура ДобавитьКоманды(ПараметрыРегистрации)
	
	//Команда формы   
	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
    НоваяКоманда.Представление = "Форма команд";
    НоваяКоманда.Идентификатор = СтрШаблон("%1_ФормаКоманд", Метаданные().Имя);
    НоваяКоманда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
    НоваяКоманда.ПоказыватьОповещение = Истина;
	//
	
	//Заполнение командами
	Для каждого СтрКоманды Из ПолучитьСписокКоманд() Цикл
		НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяКоманда, СтрКоманды);
	    НоваяКоманда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	    НоваяКоманда.ПоказыватьОповещение = Истина;
	КонецЦикла;  
	//       
	
КонецПроцедуры    

Функция ПолучитьСписокКоманд() Экспорт
	
	МассивКоманд = Новый Массив;
	
	МассивКоманд.Добавить(Новый Структура("Идентификатор, Представление", "ПолучитьАктивныеТоварыВБ", "(1) Получить активные товары"));
	МассивКоманд.Добавить(Новый Структура("Идентификатор, Представление", "ОтправитьОстатки", "(2) Отправить остатки"));
	
	МассивКоманд.Добавить(Новый Структура("Идентификатор, Представление", "ПолучитьНовыеСборочныеЗаданияВБ", "(3) Получить заказы"));
	МассивКоманд.Добавить(Новый Структура("Идентификатор, Представление", "СоздатьОтправленияВБ", "(4) Сформировать отпраления"));
	МассивКоманд.Добавить(Новый Структура("Идентификатор, Представление", "ОбновитьОтгрузки", "(5) Положить в отгрузки"));
	МассивКоманд.Добавить(Новый Структура("Идентификатор, Представление", "ОбновитьСтатусыОтправлений", "(6) Обновить статусы отправлений"));
	МассивКоманд.Добавить(Новый Структура("Идентификатор, Представление", "ПолучениеЭтикеток", "(7) Получение этикеток"));
	
	
	МассивКоманд.Добавить(Новый Структура("Идентификатор, Представление", "ПеревестиОтгрузкиВДоставку", "(8) Перевести отгрузки в доставку"));
	МассивКоманд.Добавить(Новый Структура("Идентификатор, Представление", "ОтменитьОтправления", "(9) Отменить отправления"));

	//Административные команды
	МассивКоманд.Добавить(Новый Структура("Идентификатор, Представление", "ОтправитьНулевыеОстатки", "Отправить нулевые остатки")); 
	МассивКоманд.Добавить(Новый Структура("Идентификатор, Представление", "СобратьОтгрузкиИзAPI", "Собрать отгрузки из API"));

	
	Возврат МассивКоманд;
	
КонецФункции 

Процедура ВыполнитьАлгоритмКоманды(ИмяКоманды, ПараметрыВыполнения)
	
	Кабинет = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыВыполнения, "Кабинет", Неопределено);
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	КабинетыМаркетплейсов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КабинетыМаркетплейсов КАК КабинетыМаркетплейсов
	|ГДЕ
	|	КабинетыМаркетплейсов.Активность
	|	И НЕ КабинетыМаркетплейсов.ЭтоГруппа
	|	И НЕ КабинетыМаркетплейсов.ПометкаУдаления
	|	И КабинетыМаркетплейсов.Сайт = &Сайт
	|	И ВЫБОР
	|			КОГДА &ОтборПоКабинету
	|				ТОГДА КабинетыМаркетплейсов.Ссылка = &Кабинет
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ");
	
	Запрос.УстановитьПараметр("Сайт", Справочники.СайтыМаркетплейсов.Wildberies);
	Запрос.УстановитьПараметр("ОтборПоКабинету", ЗначениеЗаполнено(Кабинет));
	Запрос.УстановитьПараметр("Кабинет", Кабинет);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ИнициализацияДанных(Выборка.Ссылка);
		
		Если ПараметрыВыполнения.Свойство("Отправление") Тогда ВходныеДанные.Вставить("Отправление", ПараметрыВыполнения.Отправление) КонецЕсли; 
		Если ПараметрыВыполнения.Свойство("Отгрузка") Тогда ВходныеДанные.Вставить("Отгрузка", ПараметрыВыполнения.Отгрузка) КонецЕсли;
		
		Попытка
			Выполнить(СтрШаблон("%1(ПараметрыВыполнения)", ИмяКоманды)); 
		Исключение                                              
			ВыходныеДанные.Ошибки.Добавить(СтрШаблон("Ошибка выполнения команды ""%1"": %2", ИмяКоманды, ОписаниеОшибки()));
		КонецПопытки;		
		
		МассивСообщений = ПолучитьСообщенияПользователю(Истина);	
		
		Для Каждого Данныесообщения Из МассивСообщений Цикл
			Если Данныесообщения.ПутьКДанным = "Ошибки" Тогда
				ВыходныеДанные.Ошибки.Добавить(Данныесообщения.Текст);
			Иначе
				ВыходныеДанные.Успешные.Добавить(Данныесообщения.Текст);
			КонецЕсли;
		КонецЦикла;
		
		ПараметрыВыполнения.РезультатВыполнения.Ответ.Добавить(Новый Структура("Кабинет, Успешные, Ошибки", Выборка.Ссылка, ВыходныеДанные.Успешные, ВыходныеДанные.Ошибки));
		
	КонецЦикла; 
	
	Если ИмяКоманды = "ПолучитьНовыеСборочныеЗаданияВБ" Тогда
		ВыполнитьКоманду("СоздатьОтправленияВБ", ПараметрыВыполнения);
	КонецЕсли;
	
КонецПроцедуры	
#КонецОбласти  

#Область ПрограмныйИнтерфейс   
Процедура ИнициализацияДанных(Кабинет, ДополнительныеПараметры = Неопределено, ЕстьОшибки = Ложь, ИзФормы = Ложь) Экспорт
	
	ЕстьОшибки = Ложь;
	
	ДанныеКабинета = Справочники.КабинетыМаркетплейсов.ДанныеКабинета(Кабинет);
		
	ВыходныеДанные = Новый Структура;  
	
	ВыходныеДанные.Вставить("Стек",     Новый Массив);
	ВыходныеДанные.Вставить("Ошибки",   Новый Массив); 
	ВыходныеДанные.Вставить("Успешные", Новый Массив); 
    ВыходныеДанные.Вставить("ИзФормы",  ИзФормы); 

	ВходныеДанные = Новый Структура; 
	ВходныеДанные.Вставить("Кабинет", 		   Кабинет);
	ВходныеДанные.Вставить("Сайт", 	  		   ДанныеКабинета.Сайт);
	ВходныеДанные.Вставить("АртикулДляПоиска", Справочники.КабинетыМаркетплейсов.ПолучитьДанныеКабинета(Кабинет, ПредопределенноеЗначение("ПланВидовХарактеристик.ДанныеКабинетовМаркетплейсов.АртикулДляПоиска"), Истина, Ложь));
	ВходныеДанные.Вставить("Токен", 		   Справочники.КабинетыМаркетплейсов.ПолучитьДанныеКабинета(Кабинет, ПредопределенноеЗначение("ПланВидовХарактеристик.ДанныеКабинетовМаркетплейсов.Токен"), Истина, Ложь));
	
	ВходныеДанные.Вставить("Организация", 	 ДанныеКабинета.Организация);
	ВходныеДанные.Вставить("Контрагент",  	 ДанныеКабинета.Контрагент);
	//ВходныеДанные.Вставить("ВремяДляОтмены", ?(ОбщегоНазначения.СсылкаСуществует(ДанныеКабинета.Сайт), ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеКабинета.Сайт, "ВремяДляОтменыКлиентом"), 0));
	ВходныеДанные.Вставить("ТестовыйКонтур", ДанныеКабинета.Тестовый);
	ВходныеДанные.Вставить("Клиент",  	  	 ?(ОбщегоНазначения.СсылкаСуществует(ДанныеКабинета.Контрагент), ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеКабинета.Контрагент, "Партнер"), ПредопределенноеЗначение("Справочник.Партнеры.ПустаяСсылка")));
		
	ВходныеДанные.Вставить("СоответсвиеСкладов", СформироватьСоответсвиеСкладовКабинета(Кабинет));
	ВходныеДанные.Вставить("МаксимальныйОстаток", ДанныеКабинета.МаксимальныйОстатокFBS);
	ВходныеДанные.Вставить("МинимальныйОстаток", ДанныеКабинета.МинимальныйОстатокFBS); 
	ВходныеДанные.Вставить("ОтсечкаTimeSlotFBS", ДанныеКабинета.ОтсечкаTimeSlotFBS); 
	ВходныеДанные.Вставить("ОтправитьНулевыеОстатки", Ложь);
	ВходныеДанные.Вставить("ДанныеКабинета", ДанныеКабинета);

	//Проверка на ошибки
	Если ПустаяСтрока(ВходныеДанные.Токен) Тогда ЗафиксироватьОшибку("Пустой токен") КонецЕсли;
	//
	
	ДополнительныеПараметры = Новый Структура("ВходныеДанные, ВыходныеДанные, ЕстьОшибки", ВходныеДанные, ВыходныеДанные, ЕстьОшибки);

КонецПроцедуры 

#КонецОбласти  

#Область СлужебныйПрограмныйИнтерфейс
Процедура ВыполнитьКоманду(ИмяКоманды, ПараметрыВыполнения) Экспорт
	
	МассивОтвета = Новый Массив;
	
	ОбщийСервер.ОтладкаВнешнейОбраотки(ИмяКоманды, ПараметрыВыполнения);
	
	Если Не ПараметрыВыполнения.РезультатВыполнения.Свойство("Ответ") Тогда ПараметрыВыполнения.РезультатВыполнения.Вставить("Ответ", Новый Массив) КонецЕсли;
	
	Если ПараметрыВыполнения.Свойство("ОбъектыНазначения") И ТипЗнч(ПараметрыВыполнения.ОбъектыНазначения) = Тип("Массив") Тогда 
		
		Для Каждого ОбъектНазначения Из ПараметрыВыполнения.ОбъектыНазначения Цикл
			
			РеквизитыОбъекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОбъектНазначения, "Кабинет");
			
			ПараметрыВыполнения.Вставить("Кабинет", РеквизитыОбъекта.Кабинет);
			
			Если ТипЗнч(ОбъектНазначения) = Тип("ДокументСсылка.Отгрузка") Тогда
				ПараметрыВыполнения.Вставить("Отгрузка", ОбъектНазначения);
			ИначеЕсли ТипЗнч(ОбъектНазначения) = Тип("ДокументСсылка.Отправление") Тогда
				ПараметрыВыполнения.Вставить("Отправление", ОбъектНазначения);
			Иначе
				ПараметрыВыполнения.Вставить("Документ", ОбъектНазначения);
			КонецЕсли;	
			
			ПараметрыВыполнения.Вставить("Документ", ОбъектНазначения);
			
			ВыполнитьАлгоритмКоманды(ИмяКоманды, ПараметрыВыполнения);
			
		КонецЦикла;	
		
	Иначе
		
		ВыполнитьАлгоритмКоманды(ИмяКоманды, ПараметрыВыполнения);
		
	КонецЕсли;	
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиКоманд

Процедура ПолучитьАктивныеТоварыВБ(ПараметрыВыполнения = Неопределено) Экспорт
	
