		КонецЕсли;	
		
		Если Не ЗначениеЗаполнено(Номенклатура) Тогда Продолжить КонецЕсли;
		
		//ДанныеТовара.Вставить("Сайт", 				 	 ВходныеДанные.Сайт);
		//ДанныеТовара.Вставить("Кабинет", 				 ВходныеДанные.Кабинет);
		//ДанныеТовара.Вставить("ИдентификаторМП", 		 XMLСтрока(ДанныеКарточки.nmID));
		//ДанныеТовара.Вставить("ИдентификаторПоставщика", XMLСтрока(ДанныеКарточки.vendorCode));
		//ДанныеТовара.Вставить("НаименованиеМП", 		 ДанныеКарточки.title);
		//ДанныеТовара.Вставить("Бренд", 					 ДанныеКарточки.brand);
		
		МассивШК = Новый Массив;
		
		Для Каждого ДанныеРазмера Из ДанныеКарточки.sizes Цикл 
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивШК, ДанныеРазмера.skus);
			ИдентификаторХарактеристикиМП = XMLСтрока(ДанныеРазмера.chrtID);
