// Процедура - Get v3 supplies
//
// Параметры:
//  Курсор	 - Число - Параметр NEXT из запроса АПИ
//
Процедура get_v3_supplies(Курсор = 0)
	
	Адрес = СтрШаблон("https://%1/api/v3/supplies", ДоменМаркетплейс());
	ЛимитВыборки = 1000;
	
	ОтветAPI = КоннекторHTTP.GetJson(Адрес, Новый Структура("limit, next", XMLСтрока(ЛимитВыборки), Курсор), СформироватьДопПараметрыЗапроса(ДоменМаркетплейс()));
	
	Если ОтветAPI.Свойство("supplies") Тогда ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВыходныеДанные.Стек, ОтветAPI.supplies) КонецЕсли;
	
	Если ОтветAPI.Свойство("supplies") И ОтветAPI.supplies.Количество() >= ЛимитВыборки Тогда get_v3_supplies(ОтветAPI.next) КонецЕсли;
	
	Если ОтветAPI = Неопределено Тогда 
		ЗафиксироватьОшибку(СтрШаблон("Ошибка получения данных: %1", Адрес));
		Возврат;
	КонецЕсли;    
	
	Если ОтветAPI.Свойство("code") Тогда 
		ЗафиксироватьОшибку(СтрШаблон("Ошибка получения данных: %1", Адрес));
		Возврат;
	КонецЕсли;   
	
КонецПроцедуры  

