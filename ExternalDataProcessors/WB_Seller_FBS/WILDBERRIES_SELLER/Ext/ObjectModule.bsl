Функция ПолучитьТекущиеОстаткиНаМаркетплейсе(ТаблицаТоваров) Экспорт 
	
	МассивОстатков = Новый Массив;

	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	СОКРЛП(ВЫРАЗИТЬ(ТЗ.ИДСклада КАК СТРОКА(50))) КАК ИДСклада,
	                      |	СОКРЛП(ВЫРАЗИТЬ(ТЗ.ИдентификаторХарактеристикиМП КАК СТРОКА(100))) КАК ИдентификаторХарактеристикиМП
	                      |ПОМЕСТИТЬ ВТ
	                      |ИЗ
	                      |	&ТЗ КАК ТЗ
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТ.ИДСклада КАК ИДСклада,
	                      |	ВТ.ИдентификаторХарактеристикиМП КАК ИдентификаторХарактеристикиМП
	                      |ИЗ
	                      |	ВТ КАК ВТ
	                      |ИТОГИ ПО
	                      |	ИДСклада");
	
	Запрос.УстановитьПараметр("ТЗ", ТаблицаТоваров);

	РезультатЗапроса = Запрос.Выполнить();  
	
	ВыборкаИДСклада = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаИДСклада.Следующий() Цикл
		МассивШтрихкодовПоСкладу = Новый Массив;
		
		Выборка = ВыборкаИДСклада.Выбрать();
	
		Пока Выборка.Следующий() Цикл
        	МассивШтрихкодовПоСкладу.Добавить(Число(Выборка.ИдентификаторХарактеристикиМП));	
		КонецЦикла;         
		
		Для каждого Пакет Из ОбщийСервер.РазложитьМассивЭлементовНаПакеты(МассивШтрихкодовПоСкладу, 1000) Цикл
			post_marketplace_v3_stock_warehouseId(ВыборкаИДСклада.ИДСклада, Пакет, МассивОстатков); 
		КонецЦикла; 
		
	КонецЦикла; 
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВЫРАЗИТЬ(ТЗ.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	                      |	СОКРЛП(ВЫРАЗИТЬ(ТЗ.ИдентификаторХарактеристикиМП КАК СТРОКА(100))) КАК ИдентификаторХарактеристикиМП,
	                      |	ВЫРАЗИТЬ(ТЗ.Габаритность КАК Перечисление.Габариты) КАК Габаритность,
	                      |	СОКРЛП(ВЫРАЗИТЬ(ТЗ.ИДСклада КАК СТРОКА(50))) КАК ИДСклада,
	                      |	ВЫРАЗИТЬ(ТЗ.Склад КАК Справочник.Склады) КАК Склад,
	                      |	ВЫРАЗИТЬ(ТЗ.Активный КАК БУЛЕВО) КАК Активный,
	                      |	ВЫРАЗИТЬ(ТЗ.Приоритетный КАК БУЛЕВО) КАК Приоритетный,
	                      |	ВЫРАЗИТЬ(ТЗ.ЗапретВыгрузкиОстатков КАК БУЛЕВО) КАК ЗапретВыгрузкиОстатков
	                      |ПОМЕСТИТЬ ВТ_АктивныеТовары
	                      |ИЗ
	                      |	&ТЗ КАК ТЗ
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	СОКРЛП(ВЫРАЗИТЬ(ТЗ_ОтстаткиМаркетплейса.ИДСклада КАК СТРОКА(50))) КАК ИДСклада,
	                      |	СОКРЛП(ВЫРАЗИТЬ(ТЗ_ОтстаткиМаркетплейса.ИдентификаторХарактеристикиМП КАК СТРОКА(100))) КАК ИдентификаторХарактеристикиМП,
	                      |	ВЫРАЗИТЬ(ТЗ_ОтстаткиМаркетплейса.Остаток КАК ЧИСЛО(10, 0)) КАК Остаток
	                      |ПОМЕСТИТЬ ВТ_ОстаткиМаркетплейса
	                      |ИЗ
	                      |	&ТЗ_ОтстаткиМаркетплейса КАК ТЗ_ОтстаткиМаркетплейса
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТ_АктивныеТовары.Номенклатура КАК Номенклатура,
	                      |	ВТ_АктивныеТовары.ИдентификаторХарактеристикиМП КАК ИдентификаторХарактеристикиМП,
	                      |	ВТ_АктивныеТовары.Габаритность КАК Габаритность,
	                      |	ВТ_АктивныеТовары.ИДСклада КАК ИДСклада,
	                      |	ВТ_АктивныеТовары.Склад КАК Склад,
	                      |	ВТ_ОстаткиМаркетплейса.Остаток КАК Остаток,
	                      |	ВТ_АктивныеТовары.Активный КАК Активный,
	                      |	ВТ_АктивныеТовары.ЗапретВыгрузкиОстатков КАК ЗапретВыгрузкиОстатков,
	                      |	ВТ_АктивныеТовары.Приоритетный КАК Приоритетный
	                      |ПОМЕСТИТЬ ВТ_Объедененная
	                      |ИЗ
	                      |	ВТ_АктивныеТовары КАК ВТ_АктивныеТовары
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОстаткиМаркетплейса КАК ВТ_ОстаткиМаркетплейса
	                      |		ПО ВТ_АктивныеТовары.ИдентификаторХарактеристикиМП = ВТ_ОстаткиМаркетплейса.ИдентификаторХарактеристикиМП
	                      |			И ВТ_АктивныеТовары.ИДСклада = ВТ_ОстаткиМаркетплейса.ИДСклада
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ВТ_АктивныеТовары.Номенклатура,
	                      |	ВТ_АктивныеТовары.ИдентификаторХарактеристикиМП,
	                      |	ВТ_АктивныеТовары.Габаритность,
	                      |	ВТ_АктивныеТовары.ИДСклада,
	                      |	ВТ_АктивныеТовары.Склад,
	                      |	ВТ_ОстаткиМаркетплейса.Остаток,
	                      |	ВТ_АктивныеТовары.Активный,
	                      |	ВТ_АктивныеТовары.ЗапретВыгрузкиОстатков,
	                      |	ВТ_АктивныеТовары.Приоритетный
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТ_Объедененная.Номенклатура КАК Номенклатура,
	                      |	ВТ_Объедененная.Склад КАК Склад
	                      |ПОМЕСТИТЬ ВТ_ТолькоНоменклатураИСклад
	                      |ИЗ
	                      |	ВТ_Объедененная КАК ВТ_Объедененная
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ВТ_Объедененная.Номенклатура,
	                      |	ВТ_Объедененная.Склад
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
	                      |	ТоварыНаСкладахОстатки.Склад КАК Склад,
	                      |	ВЫБОР
	                      |		КОГДА &ОтправитьНулевыеОстатки
	                      |			ТОГДА 0
	                      |		ИНАЧЕ ВЫБОР
	                      |				КОГДА ВЫБОР
	                      |						КОГДА ЕСТЬNULL(ТоварыНаСкладахОстатки.ВНаличииОстаток, 0) < 0
	                      |							ТОГДА 0
	                      |						ИНАЧЕ ЕСТЬNULL(ТоварыНаСкладахОстатки.ВНаличииОстаток, 0)
	                      |					КОНЕЦ - ВЫБОР
	                      |						КОГДА ЕСТЬNULL(ТоварыНаСкладахОстатки.РезервироватьНаСкладеОстаток, 0) < 0
	                      |							ТОГДА 0
	                      |						ИНАЧЕ ЕСТЬNULL(ТоварыНаСкладахОстатки.РезервироватьНаСкладеОстаток, 0)
	                      |					КОНЕЦ - ВЫБОР
	                      |						КОГДА ЕСТЬNULL(ТоварыНаСкладахОстатки.РезервироватьПоМереПоступленияОстаток, 0) < 0
	                      |							ТОГДА 0
	                      |						ИНАЧЕ ЕСТЬNULL(ТоварыНаСкладахОстатки.РезервироватьПоМереПоступленияОстаток, 0)
	                      |					КОНЕЦ < 0
	                      |					ТОГДА 0
	                      |				ИНАЧЕ ВЫБОР
	                      |						КОГДА ЕСТЬNULL(ТоварыНаСкладахОстатки.ВНаличииОстаток, 0) < 0
	                      |							ТОГДА 0
	                      |						ИНАЧЕ ЕСТЬNULL(ТоварыНаСкладахОстатки.ВНаличииОстаток, 0)
	                      |					КОНЕЦ - ВЫБОР
	                      |						КОГДА ЕСТЬNULL(ТоварыНаСкладахОстатки.РезервироватьНаСкладеОстаток, 0) < 0
	                      |							ТОГДА 0
	                      |						ИНАЧЕ ЕСТЬNULL(ТоварыНаСкладахОстатки.РезервироватьНаСкладеОстаток, 0)
	                      |					КОНЕЦ - ВЫБОР
	                      |						КОГДА ЕСТЬNULL(ТоварыНаСкладахОстатки.РезервироватьПоМереПоступленияОстаток, 0) < 0
	                      |							ТОГДА 0
	                      |						ИНАЧЕ ЕСТЬNULL(ТоварыНаСкладахОстатки.РезервироватьПоМереПоступленияОстаток, 0)
	                      |					КОНЕЦ
	                      |			КОНЕЦ
	                      |	КОНЕЦ КАК СвободныйОстаток
	                      |ПОМЕСТИТЬ ВТ_СвободныйОстаток
	                      |ИЗ
	                      |	РегистрНакопления.ЗапасыИПотребности.Остатки(
	                      |			,
	                      |			(Номенклатура, Склад) В
	                      |				(ВЫБРАТЬ
	                      |					ВТ_ТолькоНоменклатураИСклад.Номенклатура КАК Номенклатура,
	                      |					ВТ_ТолькоНоменклатураИСклад.Склад КАК Склад
	                      |				ИЗ
	                      |					ВТ_ТолькоНоменклатураИСклад КАК ВТ_ТолькоНоменклатураИСклад)) КАК ТоварыНаСкладахОстатки
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТ_Объедененная.Номенклатура КАК Номенклатура,
	                      |	ВТ_Объедененная.ИдентификаторХарактеристикиМП КАК ИдентификаторХарактеристикиМП,
	                      |	ВТ_Объедененная.Габаритность КАК Габаритность,
	                      |	ВТ_Объедененная.ИДСклада КАК ИдентификаторСклада,
	                      |	ВТ_Объедененная.Склад КАК Склад,
	                      |	ЕСТЬNULL(ВТ_Объедененная.Остаток, 0) КАК КоличествоНаМаркетплейсе,
	                      |	ЕСТЬNULL(ВЫБОР
	                      |			КОГДА ВТ_Объедененная.Активный
	                      |					И НЕ ВТ_Объедененная.ЗапретВыгрузкиОстатков
	                      |				ТОГДА ЕСТЬNULL(ВТ_СвободныйОстаток.СвободныйОстаток, 0)
	                      |			ИНАЧЕ 0
	                      |		КОНЕЦ, 0) КАК СвободныйОстаток,
	                      |	ВТ_Объедененная.Приоритетный КАК Приоритетный
	                      |ПОМЕСТИТЬ Финал
	                      |ИЗ
	                      |	ВТ_Объедененная КАК ВТ_Объедененная
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СвободныйОстаток КАК ВТ_СвободныйОстаток
	                      |		ПО ВТ_Объедененная.Номенклатура = ВТ_СвободныйОстаток.Номенклатура
	                      |			И ВТ_Объедененная.Склад = ВТ_СвободныйОстаток.Склад
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	Финал.Номенклатура КАК Номенклатура,
	                      |	Финал.ИдентификаторХарактеристикиМП КАК ИдентификаторХарактеристикиМП,
	                      |	Финал.Габаритность КАК Габаритность,
	                      |	Финал.ИдентификаторСклада КАК ИдентификаторСклада,
	                      |	Финал.Склад КАК Склад,
	                      |	Финал.КоличествоНаМаркетплейсе КАК КоличествоНаМаркетплейсе,
	                      |	ВЫБОР
	                      |		КОГДА Финал.СвободныйОстаток < &МинимальныйОстаток
	                      |				И НЕ Финал.Приоритетный
	                      |			ТОГДА 0
	                      |		ИНАЧЕ ВЫБОР
	                      |				КОГДА &МаксимальныйОстаток <> 0
	                      |					ТОГДА ВЫБОР
	                      |							КОГДА Финал.СвободныйОстаток > &МаксимальныйОстаток
	                      |								ТОГДА &МаксимальныйОстаток
	                      |							ИНАЧЕ Финал.СвободныйОстаток
	                      |						КОНЕЦ
	                      |				ИНАЧЕ ИСТИНА
	                      |			КОНЕЦ
	                      |	КОНЕЦ КАК СвободныйОстаток
	                      |ПОМЕСТИТЬ ПочтиФинал
	                      |ИЗ
	                      |	Финал КАК Финал
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ПочтиФинал.Номенклатура КАК Номенклатура,
	                      |	ПочтиФинал.ИдентификаторХарактеристикиМП КАК ИдентификаторХарактеристикиМП,
	                      |	ПочтиФинал.Габаритность КАК Габаритность,
	                      |	ПочтиФинал.ИдентификаторСклада КАК ИдентификаторСклада,
	                      |	ПочтиФинал.Склад КАК Склад,
	                      |	ПочтиФинал.КоличествоНаМаркетплейсе КАК КоличествоНаМаркетплейсе,
	                      |	ПочтиФинал.СвободныйОстаток КАК СвободныйОстаток
	                      |ИЗ
	                      |	ПочтиФинал КАК ПочтиФинал
	                      |ГДЕ
	                      |	ПочтиФинал.КоличествоНаМаркетплейсе <> ПочтиФинал.СвободныйОстаток");
	
	
	Запрос.УстановитьПараметр("ТЗ", ТаблицаТоваров);
	Запрос.УстановитьПараметр("МаксимальныйОстаток", ВходныеДанные.МаксимальныйОстаток);
	Запрос.УстановитьПараметр("МинимальныйОстаток", ВходныеДанные.МинимальныйОстаток);
	Запрос.УстановитьПараметр("ТЗ_ОтстаткиМаркетплейса", ?(МассивОстатков.Количество(), ОбщийСервер.ПреобразоватьМассивВТаблицуЗначений(МассивОстатков), ПолучитьПустуюТаблицуОстатковМаркетплейсов()));   
	Запрос.УстановитьПараметр("ОтправитьНулевыеОстатки", ВходныеДанные.ОтправитьНулевыеОстатки);
	
	Если Не ТаблицаТоваров.Количество() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Для Кабинета в рс 'товары на маркетах' нет сопоставленных товаров, пжст запустите регламент синхронихации товаров", )); 
	КонецЕсли;
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	//ОстаткиИзУТ_10(Результат);
	
	Возврат Результат;

КонецФункции

Процедура ОстаткиИзУТ_10(ТаблицаОстатков)
	
	Попытка
		
		Если Не ТаблицаОстатков.Количество() Тогда Возврат КонецЕсли;
		
		СоответствиеСкладов = Новый Соответствие;
		
		ТЗ_Склады = ТаблицаОстатков.Скопировать(, "Склад");
		ТЗ_Склады.Свернуть("Склад");
		
		ТЗ_Номенклатура = ТаблицаОстатков.Скопировать(, "Номенклатура");
		ТЗ_Номенклатура.Свернуть("Номенклатура");
		
		МассивНоменклатуры = ТЗ_Номенклатура.ВыгрузитьКолонку("Номенклатура");
		МассивСкладов = ТЗ_Склады.ВыгрузитьКолонку("Склад");
		
		НуженЗапросУТ_10 = Ложь;
		
		Для Каждого Склад Из МассивСкладов Цикл
			ОстаткиУТ10 = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Склад, "ОстаткиДляМаркетовИзУТ_10"); 
			СоответствиеСкладов.Вставить(Склад, ОстаткиУТ10); 
			Если ОстаткиУТ10 Тогда НуженЗапросУТ_10 = Истина КонецЕсли;
		КонецЦикла;
		
		Если Не НуженЗапросУТ_10 Тогда Возврат КонецЕсли;
		
		Для Каждого ТабОстаток Из ТаблицаОстатков Цикл
			 Если СоответствиеСкладов.Получить(ТабОстаток.Склад) = Истина Тогда ТабОстаток.СвободныйОстаток = 0 КонецЕсли;
		КонецЦикла;	
		
		ТелоЗапроса = Новый Структура("Склады, Номенклатура", МассивСкладов, МассивНоменклатуры);
		
		АдресУТ_10 = ОбщиеПользовательскиеНастройкиСервер.ПолучитьПользовательскиеНастройкиИзХранилища("УРЛ_БазыОстатков");
		
		ДанныеПодключения = ОбщиеПользовательскиеНастройкиСервер.ДанныеПодключенияУТ_10();
		
		ОтветAPI = КоннекторHTTP.PostJson(СтрШаблон("%1/hs/UniversalService/api?Function=StockAll", ДанныеПодключения.УРЛ), ТелоЗапроса,
		Новый Структура("ПараметрыПреобразованияJSON, Аутентификация", Новый Структура("ПрочитатьВСоответствие", Ложь),
		Новый Структура("Пользователь, Пароль", ДанныеПодключения.Пользователь, ДанныеПодключения.Пароль)));
		
		Для Каждого ДанныеОстатка Из ОтветAPI.result Цикл
			  Номенклатура = XMLЗначение(Тип("СправочникСсылка.Номенклатура"), ДанныеОстатка.UID);
			  Склад = XMLЗначение(Тип("СправочникСсылка.Склады"), ДанныеОстатка.Store);
			  
			  Если СоответствиеСкладов.Получить(Склад) = Истина Тогда 
				  
				   ПоискСтрок = ТаблицаОстатков.НайтиСтроки(Новый Структура("Склад, Номенклатура", Склад, Номенклатура));
				   Если ПоискСтрок.Количество() Тогда
					   Для Каждого ДанныеТабОстаток Из ПоискСтрок Цикл
						   ДанныеТабОстаток.СвободныйОстаток = ?(ДанныеОстатка.СвободныйОстаток < 0, 0, ДанныеОстатка.СвободныйОстаток);
					   КонецЦикла;
				   КонецЕсли;   
				  
			  КонецЕсли;			  
			
		КонецЦикла;	
		
	Исключение
		
		Сообщить(ОписаниеОшибки());
		
	КонецПопытки;
	
КонецПроцедуры	

Функция ПолучитьАктивныеТоварыПоКабиненту() Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ТоварыНаМаркетплейсах.Номенклатура КАК Номенклатура,
	|	ТоварыНаМаркетплейсах.ИдентификаторХарактеристикиМП КАК ИдентификаторХарактеристикиМП,
	|	УпаковкиЕдиницыИзмеренияГабариты.Габаритность КАК Габаритность,
	|	ТоварыНаМаркетплейсах.Активный КАК Активный, ТоварыНаМаркетплейсах.ЗапретВыгрузкиОстатков КАК ЗапретВыгрузкиОстатков 
	|ПОМЕСТИТЬ ВТ_НоменклатураСГабаритностью
	|ИЗ
	|	РегистрСведений.ТоварыНаМаркетплейсах КАК ТоварыНаМаркетплейсах
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.УпаковкиЕдиницыИзмерения.Габариты КАК УпаковкиЕдиницыИзмеренияГабариты
	|		ПО ТоварыНаМаркетплейсах.Сайт = УпаковкиЕдиницыИзмеренияГабариты.СайтМаркетплейса
	|			И ТоварыНаМаркетплейсах.Номенклатура = УпаковкиЕдиницыИзмеренияГабариты.Ссылка.Владелец
	|ГДЕ
	|	ТоварыНаМаркетплейсах.Кабинет = &Кабинет  
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_НоменклатураСГабаритностью.Номенклатура КАК Номенклатура,
	|	ВТ_НоменклатураСГабаритностью.ИдентификаторХарактеристикиМП КАК ИдентификаторХарактеристикиМП,
	|	ВТ_НоменклатураСГабаритностью.Габаритность КАК Габаритность,
	|	КабинетыМаркетплейсовСклады.ИДСклада КАК ИДСклада,
	|	КабинетыМаркетплейсовСклады.Склад КАК Склад, КабинетыМаркетплейсовСклады.Приоритетный КАК Приоритетный,
	|	ВТ_НоменклатураСГабаритностью.Активный КАК Активный, ВТ_НоменклатураСГабаритностью.ЗапретВыгрузкиОстатков КАК ЗапретВыгрузкиОстатков
	|ИЗ
	|	ВТ_НоменклатураСГабаритностью КАК ВТ_НоменклатураСГабаритностью
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КабинетыМаркетплейсов.Склады КАК КабинетыМаркетплейсовСклады
	|		ПО (ВТ_НоменклатураСГабаритностью.Габаритность = КабинетыМаркетплейсовСклады.Габаритность)
	|			И (КабинетыМаркетплейсовСклады.Ссылка = &Кабинет)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура");

	Запрос.УстановитьПараметр("Кабинет", ВходныеДанные.Кабинет);
	
	ТЗ = Запрос.Выполнить().Выгрузить();
		
	Возврат ТЗ;

КонецФункции

#КонецОбласти             

#Область СозданиеДокументов
Процедура СоздатьДокументЗаказМаркетплейса(СтрСтека)
	
	Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтрСтека, "isZeroOrder", Ложь) Тогда Возврат КонецЕсли;
	
	IDЗаказа = XMLСтрока(ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтрСтека, "id", ""));
	IDСклада = XMLСтрока(ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтрСтека, "warehouseId", ""));
	IDТовара = XMLСтрока(ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтрСтека, "nmId", ""));
		
	МетодОтгрузки = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтрСтека, "deliveryType", "");
	
	Если МетодОтгрузки <> "fbs" Тогда ЗафиксироватьОшибку(СтрШаблон("%1 Метод отгрузки %2 не предусмотрен, заказ пропущен", IDЗаказа, МетодОтгрузки)); Возврат; КонецЕсли;
	Если IDТовара = "" Или IDТовара = "0" Тогда ЗафиксироватьОшибку(СтрШаблон("Нет nmId по заказу '%1'", IDЗаказа)); Возврат; КонецЕсли;
	
	СтруктураСклада = Справочники.КабинетыМаркетплейсов.СтруктураСкладаИзКабинета(IDСклада, ВходныеДанные.Кабинет);
	
	Если Не ОбщегоНазначения.СсылкаСуществует(СтруктураСклада.Склад) Тогда ЗафиксироватьОшибку(СтрШаблон("Не найден склад '%1'", IDСклада)); Возврат; КонецЕсли;
	
	Номенклатура = РегистрыСведений.ТоварыНаМаркетплейсах.ПолучитьНоменклатуруПоИдентифкаторМП(IDТовара, ВходныеДанные.Кабинет, ВходныеДанные.Сайт);
	
	Если Не ОбщегоНазначения.СсылкаСуществует(Номенклатура) Тогда ЗафиксироватьОшибку(СтрШаблон("Не найдена номенклатура по идентификатору МП %1", IDТовара)); Возврат; КонецЕсли;
	
	ТипГруза     = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтрСтека, "cargoType", 0);
	ДатаПродавца = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтрСтека, "sellerDate", "");
	Опционально  = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтрСтека, "options", Новый Структура());
	Цена         = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтрСтека, "price", 0) / 100;
	
	Таймслот     = ?(ЗначениеЗаполнено(ВходныеДанные.ОтсечкаTimeSlotFBS), Час(ВходныеДанные.ОтсечкаTimeSlotFBS), 13);
	ДатаОтгрузки = ?(Час(ТекущаяДатаСеанса()) >= Таймслот, ТекущаяДатаСеанса() + 60 * 60 * 24, ТекущаяДатаСеанса());
	
	Если ТипГруза = 2 И ЗначениеЗаполнено(ДатаПродавца) Тогда ДатаОтгрузки = СтроковыеФункцииКлиентСервер.СтрокаВДату(ДатаПродавца) КонецЕсли;
	
	НовыйДокумент = Документы.ЗаказСМаркетплейса.СоздатьДокумент();
	
	ЗаполнитьЗначенияСвойств(НовыйДокумент, ВходныеДанные, "Организация, Клиент, Контрагент, Сайт, Кабинет");
	ЗаполнитьЗначенияСвойств(НовыйДокумент, СтруктураСклада, "Склад");
	
	ЗаполнитьЗначенияСвойств(НовыйДокумент, Новый Структура("Дата, ДатаОтгрузки, Статус, Статус1С, МетодОтгрузки, IDПлощадки, ID_СкладаМП, ДанныеЗагрузки, Габаритность, IsB2b, РаспределительныйЦентр",
	ТекущаяДатаСеанса(), ДатаОтгрузки, "new", Справочники.СтатусыМаркетплейсов.ПолучитьСтатус(ВходныеДанные.Сайт, "new"),
	ПредопределенноеЗначение("Перечисление.СхемыРаботыМаркетплейсов.FBS"), IDЗаказа, IDСклада, КоннекторHTTP.ОбъектВJson(СтрСтека),
	?(ТипГруза = 1, Перечисления.Габариты.МГТ, ?(ТипГруза = 2, Перечисления.Габариты.СГТ, ?(ТипГруза = 3, Перечисления.Габариты.КГТПлюс, Перечисления.Габариты.ПустаяСсылка))),
	ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Опционально, "isB2b", Ложь), XMLСтрока(ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтрСтека, "officeId", ""))));
	
	ЗаполнитьЗначенияСвойств(НовыйДокумент.Товары.Добавить(), Новый Структура("Номенклатура, Количество, Цена, Сумма, IDТовараМаркетплейса",
	Номенклатура, 1, Цена, Цена, IDТовара));
	
	Попытка
		НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
		ВыходныеДанные.Успешные.Добавить(СтрШаблон("Создан документ %1", НовыйДокумент.Ссылка));
		РегистрыСведений.СостояниеБизнесПроцессов.ДобавитьЗапись(, НовыйДокумент.Ссылка, Справочники.СостоянияБизнесПроцессов.ЗаказСоздан, ТекущаяДатаСеанса(),, НовыйДокумент.IDПлощадки);
		Документы.ЗаказСМаркетплейса.ПроверитьОстатки(НовыйДокумент.Ссылка, ВыходныеДанные.Ошибки);
	Исключение
		ЗафиксироватьОшибку(СтрШаблон("Ошибка создания заказа с маркетплейса '%1': %2", IDЗаказа, ОписаниеОшибки()));
	КонецПопытки;
	
КонецПроцедуры

Процедура УДалить_СоздатьДокументЗаказМаркетплейса(СтрСтека)
	
	Если СтрСтека.isZeroOrder Тогда Возврат КонецЕсли;
	
	ДатаСозданияЗаказа = ПрочитатьДатуJSON(СтрСтека.createdAt, ФорматДатыJSON.ISO);

	НовыйДокумент = Документы.ЗаказСМаркетплейса.СоздатьДокумент();   
	
	ЗаполнитьЗначенияСвойств(НовыйДокумент, ВходныеДанные);
	
	НовыйДокумент.Дата 		   		  = ТекущаяДатаСеанса();        
	
	ОтсечкаTimeSlotFBS = ВходныеДанные.ОтсечкаTimeSlotFBS;
	Таймслот = ?(ЗначениеЗаполнено(ОтсечкаTimeSlotFBS), Час(ОтсечкаTimeSlotFBS), 13);
	
	НовыйДокумент.ДатаОтгрузки 		  = ?(Час(ТекущаяДатаСеанса()) >= Таймслот, ТекущаяДатаСеанса() + 86399, ТекущаяДатаСеанса());
	НовыйДокумент.Статус	   		  = "new";
	НовыйДокумент.Статус1С     		  = Справочники.СтатусыМаркетплейсов.ПолучитьСтатус(ВходныеДанные.Сайт, НовыйДокумент.Статус);
	НовыйДокумент.IDПлощадки   		  = XMLСтрока(СтрСтека.id);   
	НовыйДокумент.ДанныеЗагрузки	  = КоннекторHTTP.ОбъектВJson(СтрСтека);
	НовыйДокумент.ID_СкладаМП 		  = XMLСтрока(СтрСтека.warehouseId);
	
	СтруктураСклада = Справочники.КабинетыМаркетплейсов.СтруктураСкладаИзКабинета(XMLСтрока(СтрСтека.warehouseId), ВходныеДанные.Кабинет);  
	
	Если Не ОбщегоНазначения.СсылкаСуществует(СтруктураСклада.Склад) Тогда 
		ЗафиксироватьОшибку(СтрШаблон("Не найден склад '%1'", XMLСтрока(СтрСтека.warehouseId)));
		Возврат;
	КонецЕсли;           
	
	ЗаполнитьЗначенияСвойств(НовыйДокумент, СтруктураСклада, "Склад");  

	Если СтрСтека.cargoType = 1 Тогда
		НовыйДокумент.Габаритность = Перечисления.Габариты.МГТ;
	ИначеЕсли СтрСтека.cargoType = 2 Тогда
		НовыйДокумент.Габаритность = Перечисления.Габариты.СГТ;
		Если СтрСтека.Свойство("sellerDate") Тогда НовыйДокумент.ДатаОтгрузки = СтроковыеФункцииКлиентСервер.СтрокаВДату(СтрСтека.sellerDate) КонецЕсли;
	ИначеЕсли СтрСтека.cargoType = 3 Тогда
		НовыйДокумент.Габаритность = Перечисления.Габариты.КГТПлюс;
	КонецЕсли;
	
	Если СтрСтека.deliveryType <> "fbs" Тогда
		ЗафиксироватьОшибку(СтрШаблон("%1 Метод отгрузки %2 не предусмотрен, заказ пропущен ", НовыйДокумент.IDПлощадки, СтрСтека.deliveryType));
		Возврат;
	КонецЕсли; 
	
	НовыйДокумент.МетодОтгрузки = ПредопределенноеЗначение("Перечисление.СхемыРаботыМаркетплейсов.FBS");

	Если XMLСтрока(СтрСтека.nmId) = "" Или XMLСтрока(СтрСтека.nmId) = "0" Тогда           
		ЗафиксироватьОшибку(СтрШаблон("Нет nmId по заказу '%1'", НовыйДокумент.IDПлощадки));
		Возврат;
	КонецЕсли;
	
	Номенклатура = РегистрыСведений.ТоварыНаМаркетплейсах.ПолучитьНоменклатуруПоИдентифкаторМП(XMLСтрока(СтрСтека.nmId), ВходныеДанные.Кабинет, ВходныеДанные.Сайт); 
	
	Если Не ОбщегоНазначения.СсылкаСуществует(Номенклатура) Тогда
		ЗафиксироватьОшибку(СтрШаблон("Не найдена номенклатура по идентификатору МП %1", XMLСтрока(СтрСтека.nmId)));
	    Возврат;
	КонецЕсли; 
    
	ЗаполнитьЗначенияСвойств(НовыйДокумент.Товары.Добавить(), Новый Структура("Номенклатура, Количество, Цена, Сумма, IDТовараМаркетплейса",
	Номенклатура, 1, СтрСтека.price / 100, СтрСтека.price / 100, XMLСтрока(СтрСтека.nmId)));
	
	Опционально = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтрСтека, "options", Новый Структура());
	
	НовыйДокумент.IsB2b = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Опционально, "isB2b", Ложь);
	НовыйДокумент.РаспределительныйЦентр = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтрСтека, "officeId", "");

	Попытка
	    НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
		ВыходныеДанные.Успешные.Добавить(СтрШаблон("Создан документ %1", НовыйДокумент.Ссылка)); 
		РегистрыСведений.СостояниеБизнесПроцессов.ДобавитьЗапись(, НовыйДокумент.Ссылка, Справочники.СостоянияБизнесПроцессов.ЗаказСоздан, ТекущаяДатаСеанса(),, НовыйДокумент.IDПлощадки);
		Документы.ЗаказСМаркетплейса.ПроверитьОстатки(НовыйДокумент.Ссылка, ВыходныеДанные.Ошибки);
	Исключение
		ЗафиксироватьОшибку(СтрШаблон("Ошибка создания заказа с маркетплейса '%1': %2", СтрСтека.id, ОписаниеОшибки()));	
	КонецПопытки;
	
КонецПроцедуры  

Процедура СоздатьДокументОтправление(ЗаказСМаркетплейса)
	
	НовыйДокумент = Документы.Отправление.СоздатьДокумент();  
	
	ЗаполнитьЗначенияСвойств(НовыйДокумент, ЗаказСМаркетплейса, "ДатаОтгрузки, IDПлощадки, Статус, Дата, Габаритность, ID_СкладаМП, IsB2b");

	НовыйДокумент.Статус1С = Справочники.СтатусыМаркетплейсов.ПолучитьСтатус(ВходныеДанные.Сайт, НовыйДокумент.Статус);
	
	НовыйДокумент.Заполнить(ЗаказСМаркетплейса); 
	
	Попытка
		НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);  
		
		ДобавитьОтправлениеВПоставку(НовыйДокумент.Ссылка);
	Исключение
		ЗафиксироватьОшибку(СтрШаблон("Ошибка создания отправления на основании %1: %2", ЗаказСМаркетплейса, ОписаниеОшибки())); 
	КонецПопытки;

КонецПроцедуры
	
#КонецОбласти

#Область СлужебныеПроцедурыИФункции  

Функция СформироватьСоответсвиеСкладовКабинета(Кабинет)

	РезЗапроса = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Кабинет, "Склады");
	ВыборкаСклады = РезЗапроса.Выбрать();
	СоответствиеСкладов = Новый Соответствие;
	
	Пока ВыборкаСклады.Следующий() Цикл
		
		//СоответствиеСкладов.Вставить(ВыборкаСклады.ИДСклада, ВыборкаСклады.Склад);
		СоответствиеСкладов.Вставить(ВыборкаСклады.ИДСклада, ВыборкаСклады.Наименование);
		
	КонецЦикла;
	
	Возврат СоответствиеСкладов;
	
КонецФункции	

Функция ПолучитьПустуюТаблицуОстатковМаркетплейсов()

	ТаблицаЗначений = Новый ТаблицаЗначений;
	
	ТаблицаЗначений.Колонки.Добавить("ИДСклада", ОбщегоНазначения.ОписаниеТипаСтрока(50));
