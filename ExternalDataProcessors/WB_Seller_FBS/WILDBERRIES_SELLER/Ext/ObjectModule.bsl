#Область ДополнительныеПараметры

Функция СформироватьДопПараметрыЗапроса(Хост = "suppliers-api.wildberries.ru", МаксимальноеКоличествоПовторов = 4, КоэффициентЭкспоненциальнойЗадержки = 10, ПовторятьДляКодовСостояний = 429, 
									   ПараметрыЗапроса = Неопределено)
	
	СтруктураПараметров = Новый Структура;
	
	СтруктураПараметров.Вставить("ПараметрыПреобразованияJSON", Новый Структура("ПрочитатьВСоответствие", Ложь)); 
	СтруктураПараметров.Вставить("Заголовки", 					СформироватьЗаголовки(Хост)); 
	СтруктураПараметров.Вставить("Таймаут", 					1200); 
	СтруктураПараметров.Вставить("ПроверятьSSL", 				Ложь); 
	
	Если Не МаксимальноеКоличествоПовторов = 0 Тогда  
		СтруктураПараметров.Вставить("МаксимальноеКоличествоПовторов", МаксимальноеКоличествоПовторов);
		СтруктураПараметров.Вставить("КоэффициентЭкспоненциальнойЗадержки", КоэффициентЭкспоненциальнойЗадержки);
		СтруктураПараметров.Вставить("ПовторятьДляКодовСостояний", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПовторятьДляКодовСостояний));
	КонецЕсли;

	Если Не ПараметрыЗапроса = Неопределено Тогда 
		СтруктураПараметров.Вставить("ПараметрыЗапроса", ПараметрыЗапроса);
	КонецЕсли;
	
	Возврат СтруктураПараметров;

КонецФункции

