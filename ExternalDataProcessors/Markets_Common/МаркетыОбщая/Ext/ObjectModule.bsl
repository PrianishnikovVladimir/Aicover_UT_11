	//МассивОтгрузки.Добавить(XMLЗначение(Тип("ДокументСсылка.Отгрузка"), "7a01ed70-303b-11f1-ab1b-005056a8011a"));
	//МассивОтгрузки.Добавить(XMLЗначение(Тип("ДокументСсылка.Отгрузка"), "18094a64-2dac-11f1-ab1a-005056a8011a"));
