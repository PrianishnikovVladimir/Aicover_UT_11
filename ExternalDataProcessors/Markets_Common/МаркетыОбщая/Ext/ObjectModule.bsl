				ОтправлениеОбъект = Выборка.Отправление.ПолучитьОбъект();
				ОтправлениеОбъект.Заблокировать();
				ОтправлениеОбъект.Статус1С = СтатусЗинаОтмена;
				ОтправлениеОбъект.Записать(РежимЗаписиДокумента.Проведение);	
				
				ОбщегоНазначения.СообщитьПользователю(СтрШаблон("%1 Отменен", Выборка.Отправление),,, "Успешные");
				
			Исключение	
				
			КонецПопытки;
			
		КонецЕсли;
		
		//Если Выборка.СтатусЗаказаМП <> СтатусЗинаОтмена Тогда 
