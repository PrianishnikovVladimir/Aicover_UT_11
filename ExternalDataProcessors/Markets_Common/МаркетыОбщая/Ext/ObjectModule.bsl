КонецФункции            

Процедура ДобавитьКоманды(ПараметрыРегистрации)
	
	//Команда формы   
	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
    НоваяКоманда.Представление = "Форма команд";
    НоваяКоманда.Идентификатор = СтрШаблон("%1_ФормаКоманд", Метаданные().Имя);
    НоваяКоманда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
    НоваяКоманда.ПоказыватьОповещение = Истина;
	//
	
	//Заполнение командами
	Для каждого СтрКоманды Из ПолучитьСписокКоманд() Цикл
		НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяКоманда, СтрКоманды);
	    НоваяКоманда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	    НоваяКоманда.ПоказыватьОповещение = Истина;
	КонецЦикла;  
	//

КонецПроцедуры    

Функция ПолучитьСписокКоманд() Экспорт
	
	МассивКоманд = Новый Массив;
	
	МассивКоманд.Добавить(Новый Структура("Идентификатор, Представление", "СформироватьПередачуТоваров", "Сформировать передачу товаров на основании отгрузок"));
	МассивКоманд.Добавить(Новый Структура("Идентификатор, Представление", "РаспределениеЗапасов", "Регалмент по РС Распределение запасов"));
	МассивКоманд.Добавить(Новый Структура("Идентификатор, Представление", "АрхивироватьДокументы", "Архивировать документы"));
	МассивКоманд.Добавить(Новый Структура("Идентификатор, Представление", "ОбработатьСтатусОтгрузкиУпаковано", "Проставить статус отгрузки ""Упаковано"""));
	МассивКоманд.Добавить(Новый Структура("Идентификатор, Представление", "ПроблемныеЗаказыДержатРезерв", "Проставить состояние ""Держат резерв"" проблемным заказам"));
	МассивКоманд.Добавить(Новый Структура("Идентификатор, Представление", "ОчиститьУведомленияМаркетплейсов", "Очистить уведомления маркетплейсов старше 10 дней"));
	
	
	//МассивКоманд.Добавить(Новый Структура("Идентификатор, Представление", "СформироватьПередачуТоваровТест", "Тестовый тест"));
	
	Возврат МассивКоманд;
	
КонецФункции 

Процедура Инициализация()
	
	ВыходныеДанные = Новый Структура("Успешные, Ошибки, СообщенияПользователю", Новый Массив, Новый Массив, Новый Массив);
	
КонецПроцедуры	

Процедура ВыполнитьКоманду(ИмяКоманды, ПараметрыВыполнения) Экспорт
	
	Инициализация();
	
	Попытка
		Выполнить(СтрШаблон("%1(ПараметрыВыполнения)", ИмяКоманды)); 
	Исключение                                              
		ВыходныеДанные.СообщенияПользователю.Добавить(СтрШаблон("Ошибка выполнения команды ""%1"": %2", ИмяКоманды, ОписаниеОшибки()));
	КонецПопытки; 
	
	МассивСообщений = ПолучитьСообщенияПользователю(Истина);
	Для Каждого СообщениеПользователя Из МассивСообщений Цикл
		ВыходныеДанные.СообщенияПользователю.Добавить(СообщениеПользователя.Текст);
	КонецЦикла;	
	
	Если ТипЗнч(ПараметрыВыполнения) = Тип("Структура") И ПараметрыВыполнения.Свойство("РезультатВыполнения") Тогда 
		ПараметрыВыполнения.РезультатВыполнения.Вставить("Ответ", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Новый Структура("СообщенияПользователю, Ошибки", ВыходныеДанные.СообщенияПользователю, ВыходныеДанные.Ошибки))); 
	КонецЕсли; 	
		
КонецПроцедуры  

#КонецОбласти  

#Область ОбработчикиКоманд

Процедура РаспределениеЗапасов(ПараметрыВыполнения) Экспорт

	ТаблицаОшибокВременная = Новый ТаблицаЗначений();
	ТаблицаОшибокВременная.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаОшибокВременная.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТаблицаОшибокВременная.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.Склады"));
	ТаблицаОшибокВременная.Колонки.Добавить("Назначение", Новый ОписаниеТипов("СправочникСсылка.Назначения"));
	Пакет = РаспределениеЗапасов.ОшибкиПроверкиКорректностиЗаписейРегистраСведенийРаспределениеЗапасов();
	Для Счетчик = 1 По Пакет.Количество() Цикл
		Таблица = Пакет[Счетчик - 1].Выгрузить();
		Для Каждого Строка Из Таблица Цикл
			ЗаполнитьЗначенияСвойств(ТаблицаОшибокВременная.Добавить(), Строка);
		КонецЦикла;
	КонецЦикла;
	ТаблицаОшибокВременная.Свернуть("Номенклатура,Характеристика,Склад,Назначение");
	
	ОбработкаРС = Обработки.ИсправлениеОшибокВРегистреСведенийРаспределениеЗапасов.Создать();
	
	АдресХранилища = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);
	
	ОбработкаРС.ИсправитьОшибкиРегистраСведенийРаспределениеЗапасовВФоне(Новый Структура("Аналитики", ТаблицаОшибокВременная), АдресХранилища); 

	ВыходныеДанные.Вставить("СообщенияПользователю", ПолучитьИзВременногоХранилища(АдресХранилища).Сообщения);
	
КонецПроцедуры 

Процедура ПроблемныеЗаказыДержатРезерв(ПараметрыВыполнения) Экспорт

	ОтрицательныйРезерв(); 
	ПоложительныйРезерв(); 
	КонтрольПроблемныхПоРезерву();
	//ВыходныеДанные.Вставить("СообщенияПользователю", ПолучитьИзВременногоХранилища(АдресХранилища).Сообщения);
	
КонецПроцедуры 

Процедура СформироватьПередачуТоваров(ПараметрыВыполнения) Экспорт
	
	Валюта = Константы.ВалютаУправленческогоУчета.Получить();
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Отгрузка.Ссылка КАК Отгрузка,
	|	ПередачаТоваровХранителю.Ссылка КАК ПередачаТоваровХранителю,
	|	Отгрузка.Кабинет КАК Кабинет,
	|	Отгрузка.Кабинет.СоглашениеКомиссия КАК Соглашение,
	|	Отгрузка.Склад КАК Склад,
	|	Отгрузка.Кабинет.Договор КАК Договор,
	|	Отгрузка.Кабинет.Подразделение КАК Подразделение
	|ИЗ
	|	Документ.Отгрузка КАК Отгрузка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаТоваровХранителю КАК ПередачаТоваровХранителю
	|		ПО Отгрузка.Ссылка = ПередачаТоваровХранителю.ДокументОснование
	|			И (НЕ ПередачаТоваровХранителю.ПометкаУдаления)
	|ГДЕ
	|	Отгрузка.Закрыто
	|	И НЕ Отгрузка.ПометкаУдаления
	|	И ПередачаТоваровХранителю.Ссылка ЕСТЬ NULL
	|	И Отгрузка.Проведен");	
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Отказ = Ложь;
		
		Если Не ЗначениеЗаполнено(Выборка.Соглашение) Тогда
			Общегоназначения.СообщитьПользователю(СтрШаблон("%1 У кабинета %2 не заполнено Соглашение. Создание передачи товаров невозможно", Выборка.Отгрузка, Выборка.Кабинет),,, "Ошибки", Отказ);
		КонецЕсли; 
		
		Если Не ЗначениеЗаполнено(Выборка.Склад) Тогда
			Общегоназначения.СообщитьПользователю(СтрШаблон("%1 в отгрузке не заполнен склад. Создание заказа клиента невозможно", Выборка.Отгрузка),,, "Ошибки", Отказ);
		КонецЕсли;
		
		Если Отказ Тогда Продолжить КонецЕсли;
		
		МассивТоваров = МассивТовавровОтгрузки(Выборка.Отгрузка, Выборка.Склад, ТекущаяДатаСеанса());
		
		Если Не МассивТоваров.Количество() Тогда Продолжить КонецЕсли;
		
		ПередачаТоваров = Документы.ПередачаТоваровХранителю.СоздатьДокумент();
		ЗаполнитьЗначенияСвойств(ПередачаТоваров, Выборка.Отгрузка,, "Номер, Дата, Проведен"); 
		ПередачаТоваров.Комментарий = СтрШаблон("Создано автоматически. на основании отгрузки %1", Выборка.Отгрузка);
		ПередачаТоваров.Партнер = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПередачаТоваров.Контрагент, "Партнер");
		ПередачаТоваров.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз;
		ПередачаТоваров.ХозяйственнаяОперация =	Перечисления.ХозяйственныеОперации.РеализацияЧерезКомиссионераБезПереходаПраваСобственности;
		ПередачаТоваров.Валюта = Валюта;
		
		ПередачаТоваров.Заполнить(Выборка.Соглашение);
		Если Не ЗначениеЗаполнено(ПередачаТоваров.Договор) Тогда ПередачаТоваров.Договор = Выборка.Договор КонецЕсли;
		ПередачаТоваров.АдресДоставки = Строка(Выборка.Кабинет);
		ПередачаТоваров.УстановитьНовыйНомер();
		ПередачаТоваров.Дата = ТекущаяДатаСеанса();
		ПередачаТоваров.Подразделение = Выборка.Подразделение;
		
		КэшированныеЗначения = Неопределено;
		
		Для Каждого ДанныеТовара Из МассивТоваров Цикл
			
			НовСтрокаЗаказа = ПередачаТоваров.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрокаЗаказа, ДанныеТовара);
			НовСтрокаЗаказа.Цена = ОбщийУчетВызовСервере.ПолучитьСебестоимостьТовара(НовСтрокаЗаказа.Номенклатура, ПередачаТоваров.Дата);
			Если НовСтрокаЗаказа.Цена = 0 Тогда НовСтрокаЗаказа.Цена = 1 КонецЕсли;
			
			ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(НовСтрокаЗаказа, Новый Структура("ЗаполнитьВидЦены, ЗаполнитьЦенуПродажи, ПересчитатьСумму",
			Новый Структура("ВидЦены", Справочники.ВидыЦен.Себестоимость), Новый Структура("Валюта, Дата, ВидЦены", ПередачаТоваров.Валюта, ПередачаТоваров.Дата,
			Справочники.ВидыЦен.Себестоимость)), КэшированныеЗначения);		
			
		КонецЦикла;	
		
		ПередачаТоваров.ДокументОснование = Выборка.Отгрузка;
		
		Попытка
			
			ПередачаТоваров.ОбменДанными.Загрузка = Истина;
			ПередачаТоваров.ДополнительныеСвойства.Вставить("БезОшибокНаПроверкуПоОстаткам", Истина);
			ПередачаТоваров.Записать();
			Общегоназначения.СообщитьПользователю(СтрШаблон("На основании %1 создан %2", Выборка.Отгрузка, ПередачаТоваров.Ссылка),,, "Успешные", Отказ); 
			РегистрыСведений.СостояниеБизнесПроцессов.ДобавитьЗапись("Маркетплейсы", ПередачаТоваров.Ссылка, Справочники.СостоянияБизнесПроцессов.ПередачаТоваровСозданаВ1с,,, ПередачаТоваров.Ссылка);
			РегистрыСведений.СостояниеБизнесПроцессов.ДобавитьЗапись("Маркетплейсы", Выборка.Отгрузка, Справочники.СостоянияБизнесПроцессов.НаОснованииОтгрузкиСозданаПередачаТовара,,, ПередачаТоваров.Ссылка);
			ПередачаТоваров.ОбменДанными.Загрузка = Ложь;
			ПередачаТоваров.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
			
		Исключение
			
			РегистрыСведений.ОтложенноеПроведениеДокументов.ДобавитьДокументВОчередьНаПроведение(ПередачаТоваров.Ссылка);
			
			Общегоназначения.СообщитьПользователю(СтрШаблон("Не удалось провести %1", ПередачаТоваров.Ссылка),,, "Ошибки", Отказ);
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры 

Процедура СформироватьПередачуТоваровТест(ПараметрыВыполнения) Экспорт
	
	Валюта = Константы.ВалютаУправленческогоУчета.Получить();
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Отгрузка.Ссылка КАК Отгрузка,
	|	ПередачаТоваровХранителю.Ссылка КАК ПередачаТоваровХранителю,
	|	Отгрузка.Кабинет КАК Кабинет,
	|	Отгрузка.Кабинет.СоглашениеКомиссия КАК Соглашение,
	|	Отгрузка.Склад КАК Склад,
	|	Отгрузка.Кабинет.Договор КАК Договор,
	|	Отгрузка.Кабинет.Подразделение КАК Подразделение,
	|	ПередачаТоваровХранителю.Дата КАК Дата
