Функция МассивТовавровОтгрузки(Отгрузка, Склад, ДатаОстатков = Неопределено)
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ОтгрузкаОтправления.Номенклатура КАК Номенклатура,
	|	СУММА(ОтгрузкаОтправления.Количество) КАК Количество,
	|	1 КАК цена,
	|	СУММА(ОтгрузкаОтправления.Количество) КАК Сумма,
	|	СУММА(ОтгрузкаОтправления.Количество) КАК СуммаСНДС,
	|	ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.НеТребуется) КАК ВариантОбеспечения,
	|	СУММА(ОтгрузкаОтправления.Количество) КАК КоличествоУпаковок,
	|	ОтгрузкаОтправления.Номенклатура.СтавкаНДС КАК СтавкаНДС,
	|	ОтгрузкаОтправления.Ссылка.Склад КАК Склад,
	|	ОтгрузкаОтправления.ЗаказМП КАК ЗаказМП,
	|	МАКСИМУМ(ЕСТЬNULL(ЗапасыИПотребностиОстатки.РезервироватьНаСкладеОстаток, 0)) КАК Резерв
	|ИЗ
	|	Документ.Отгрузка.Отправления КАК ОтгрузкаОтправления
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗапасыИПотребности.Остатки(&ДатаОстатков, Склад = &Склад) КАК ЗапасыИПотребностиОстатки
	|		ПО ОтгрузкаОтправления.Номенклатура = ЗапасыИПотребностиОстатки.Номенклатура
	|			И ОтгрузкаОтправления.ЗаказМП = ЗапасыИПотребностиОстатки.Заказ
	|ГДЕ
	|	ОтгрузкаОтправления.Ссылка = &Отгрузка
	|	И ОтгрузкаОтправления.Отправление.Упакован
	|	И ЕСТЬNULL(ЗапасыИПотребностиОстатки.РезервироватьНаСкладеОстаток, 0) > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ОтгрузкаОтправления.Номенклатура,
	|	ОтгрузкаОтправления.Номенклатура.СтавкаНДС,
	|	ОтгрузкаОтправления.Ссылка.Склад,
	|	ОтгрузкаОтправления.ЗаказМП");
	
	Запрос.УстановитьПараметр("Отгрузка", Отгрузка);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("ДатаОстатков", ?(ЗначениеЗаполнено(ДатаОстатков), ДатаОстатков, ТекущаяДатаСеанса()));
	
	Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(Запрос.Выполнить().Выгрузить());	
	
КонецФункции	

Процедура ОтрицательныйРезерв()
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ЗапасыИПотребностиОстатки.Заказ КАК Заказ, ЗапасыИПотребностиОстатки.Заказ.IDПлощадки Как IDПлощадки,
	|	СУММА(ЗапасыИПотребностиОстатки.РезервироватьНаСкладеОстаток) КАК РезервироватьНаСкладеОстаток,
	|	ЕСТЬNULL(СостояниеБизнесПроцессов.Решено, ЛОЖЬ) КАК Решено
	|ИЗ
	|	РегистрНакопления.ЗапасыИПотребности.Остатки КАК ЗапасыИПотребностиОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеБизнесПроцессов КАК СостояниеБизнесПроцессов
	|		ПО (ЗапасыИПотребностиОстатки.Заказ = СостояниеБизнесПроцессов.Объект)
	|			И (СостояниеБизнесПроцессов.Состояние = ЗНАЧЕНИЕ(Справочник.СостоянияБизнесПроцессов.ЗаказДержитРезерв))
	|ГДЕ
	|	ЗапасыИПотребностиОстатки.Заказ <> НЕОПРЕДЕЛЕНО
	|	И ЗапасыИПотребностиОстатки.Заказ ССЫЛКА Документ.ЗаказСМаркетплейса
	|	И СостояниеБизнесПроцессов.Решено ЕСТЬ NULL
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗапасыИПотребностиОстатки.Заказ,
	|	ЕСТЬNULL(СостояниеБизнесПроцессов.Решено, ЛОЖЬ)
	|
	|ИМЕЮЩИЕ
	|	СУММА(ЗапасыИПотребностиОстатки.РезервироватьНаСкладеОстаток) < 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Заказ УБЫВ
	|АВТОУПОРЯДОЧИВАНИЕ");
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		РегистрыСведений.СостояниеБизнесПроцессов.ДобавитьЗапись(, Выборка.Заказ, Справочники.СостоянияБизнесПроцессов.ЗаказДержитРезерв,
		ТекущаяДатаСеанса(), Ложь, Выборка.IDПлощадки, "По заказу отрицательный резерв", Ложь); 
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("%1 добавлен к проблемным ""держит отрицательный резерв"" ", Выборка.Заказ),,, "Успешные"); 
	КонецЦикла;	
	
КонецПроцедуры  

Процедура ПоложительныйРезерв()
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ЗапасыИПотребностиОстатки.Заказ КАК Заказ, ЗапасыИПотребностиОстатки.Заказ.IDПлощадки Как IDПлощадки,
	|	СУММА(ЗапасыИПотребностиОстатки.РезервироватьНаСкладеОстаток) КАК РезервироватьНаСкладеОстаток,
	|	ЕСТЬNULL(СостояниеБизнесПроцессов.Решено, ЛОЖЬ) КАК Решено
	|ИЗ
	|	РегистрНакопления.ЗапасыИПотребности.Остатки(, Заказ ССЫЛКА Документ.ЗаказСМаркетплейса И Заказ.ДатаОтгрузки < &ДатаОтгрузки) КАК ЗапасыИПотребностиОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеБизнесПроцессов КАК СостояниеБизнесПроцессов
	|		ПО (ЗапасыИПотребностиОстатки.Заказ = СостояниеБизнесПроцессов.Объект)
	|			И (СостояниеБизнесПроцессов.Состояние = ЗНАЧЕНИЕ(Справочник.СостоянияБизнесПроцессов.ЗаказДержитРезерв))
	|ГДЕ
	|	ЗапасыИПотребностиОстатки.Заказ <> НЕОПРЕДЕЛЕНО
	|	И СостояниеБизнесПроцессов.Решено ЕСТЬ NULL
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗапасыИПотребностиОстатки.Заказ,
	|	ЕСТЬNULL(СостояниеБизнесПроцессов.Решено, ЛОЖЬ)
	|
	|ИМЕЮЩИЕ
	|	СУММА(ЗапасыИПотребностиОстатки.РезервироватьНаСкладеОстаток) > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Заказ УБЫВ
	|АВТОУПОРЯДОЧИВАНИЕ");
	
	Запрос.УстановитьПараметр("ДатаОтгрузки", ТекущаяДатаСеанса()-60*60*24*2);
	РезультатЗапроса = Запрос.Выполнить();
	
	// Выборка
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		РегистрыСведений.СостояниеБизнесПроцессов.ДобавитьЗапись(, Выборка.Заказ, Справочники.СостоянияБизнесПроцессов.ЗаказДержитРезерв,
		ТекущаяДатаСеанса(), Ложь, Выборка.IDПлощадки, "Заказ держит резерв товаров", Ложь);
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("%1 добавлен к проблемным ""держит резерв по заказу более 2 суток"" ", Выборка.Заказ),,, "Успешные");
	КонецЦикла;	
	
КонецПроцедуры 

Процедура КонтрольПроблемныхПоРезерву()
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	СостояниеБизнесПроцессов.Объект КАК Заказ,
	|	ЕСТЬNULL(ЗапасыИПотребностиОстатки.РезервироватьНаСкладеОстаток, 0) КАК РезервироватьНаСкладеОстаток
	|ИЗ
	|	РегистрСведений.СостояниеБизнесПроцессов КАК СостояниеБизнесПроцессов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗапасыИПотребности.Остатки КАК ЗапасыИПотребностиОстатки
	|		ПО (ЗапасыИПотребностиОстатки.Заказ = СостояниеБизнесПроцессов.Объект)
	|			И (СостояниеБизнесПроцессов.Состояние = ЗНАЧЕНИЕ(Справочник.СостоянияБизнесПроцессов.ЗаказДержитРезерв))
	|ГДЕ
	|	ЕСТЬNULL(ЗапасыИПотребностиОстатки.РезервироватьНаСкладеОстаток, 0) = 0
	|	И НЕ СостояниеБизнесПроцессов.Решено
	|	И СостояниеБизнесПроцессов.Состояние = ЗНАЧЕНИЕ(Справочник.СостоянияБизнесПроцессов.ЗаказДержитРезерв)");
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		РегистрыСведений.СостояниеБизнесПроцессов.ОтметитьЗаписьРешенной(, Выборка.Заказ, Справочники.СостоянияБизнесПроцессов.ЗаказДержитРезерв, ТекущаяДатаСеанса());
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("%1 отмечен как ""решено"" больше не держит резерв", Выборка.Заказ),,, "Успешные");
	КонецЦикла;	
	
КонецПроцедуры 
#КонецОбласти   




